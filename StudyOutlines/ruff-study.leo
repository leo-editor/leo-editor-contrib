<t tx="ekr.20231231171048.310">#[ignore]
#[test]
fn import_star_not_exported() {
    // Report unused import when not needed to satisfy __all__.
    flakes(
        r"
    from foolib import *
    a = 1
    __all__ = ['a']
    ",
        &amp;[Rule::UndefinedLocalWithImportStar, Rule::UnusedImport],
