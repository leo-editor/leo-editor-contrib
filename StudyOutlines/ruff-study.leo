/// Collect all comments in an import block.
pub(crate) fn collect_comments&lt;'a&gt;(
    range: TextRange,
    locator: &amp;'a Locator,
    indexer: &amp;'a Indexer,
) -&gt; Vec&lt;Comment&lt;'a&gt;&gt; {
    indexer
        .comment_ranges()
        .comments_in_range(range)
        .iter()
        .map(|range| Comment {
            value: locator.slice(*range).into(),
            range: *range,
        })
        .collect()
}
