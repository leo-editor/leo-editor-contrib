<t tx="ekr.20231231171116.121">fn call_path(&amp;self) -&gt; &amp;[&amp;str] {
    match self {
        Self::Import(import) =&gt; import.call_path(),
        Self::SubmoduleImport(import) =&gt; import.call_path(),
        Self::FromImport(import) =&gt; import.call_path(),
    }
}
