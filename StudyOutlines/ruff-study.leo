<t tx="ekr.20231231171114.22">// Checks if the character c is a valid continuation character as described
// in https://docs.python.org/3/reference/lexical_analysis.html#identifiers
fn is_identifier_continuation(c: char) -&gt; bool {
    match c {
        'a'..='z' | 'A'..='Z' | '_' | '0'..='9' =&gt; true,
        c =&gt; is_xid_continue(c),
    }
}
