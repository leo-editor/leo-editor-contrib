<t tx="ekr.20231231171101.26">/// Adds an `explanation()` method from the doc comment.
#[proc_macro_attribute]
pub fn violation(_attr: TokenStream, item: TokenStream) -&gt; TokenStream {
    let violation = parse_macro_input!(item as ItemStruct);
    violation::violation(&amp;violation)
        .unwrap_or_else(syn::Error::into_compile_error)
        .into()
}
