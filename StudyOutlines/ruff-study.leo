<t tx="ekr.20231231171022.52">/// Lex a `noqa` directive with case-insensitive matching.
#[inline]
fn lex_noqa(line: &amp;str) -&gt; Option&lt;&amp;str&gt; {
    match line.as_bytes() {
        [b'n' | b'N', b'o' | b'O', b'q' | b'Q', b'a' | b'A', ..] =&gt; Some(&amp;line["noqa".len()..]),
        _ =&gt; None,
    }
}
</t>
<t tx="ekr.20231231171022.53">/// Lex a code delimiter, which can either be a comma or whitespace.
#[inline]
fn lex_delimiter(line: &amp;str) -&gt; Option&lt;&amp;str&gt; {
    let mut chars = line.chars();
    if let Some(c) = chars.next() {
        if c == ',' || c.is_whitespace() {
            Some(chars.as_str())
        } else {
            None
        }
    } else {
        None
    }
}
</t>
