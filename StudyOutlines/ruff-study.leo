<t tx="ekr.20231231171111.53">fn fmt_fields(&amp;self, item: &amp;StmtRaise, f: &amp;mut PyFormatter) -&gt; FormatResult&lt;()&gt; {
    let StmtRaise {
        range: _,
        exc,
        cause,
    } = item;

    token("raise").fmt(f)?;

    if let Some(value) = exc {
        write!(
            f,
            [
                space(),
                maybe_parenthesize_expression(value, item, Parenthesize::Optional)
            ]
        )?;
    }

    if let Some(value) = cause {
        write!(
            f,
            [
                space(),
                token("from"),
                space(),
                maybe_parenthesize_expression(value, item, Parenthesize::Optional)
            ]
        )?;
    }
    Ok(())
}
