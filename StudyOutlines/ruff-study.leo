<t tx="ekr.20231231171018.115">#[inline]
fn cache_key(&amp;self, state: &amp;mut CacheKeyHasher) {
    match self {
        None =&gt; state.write_usize(0),
        Some(value) =&gt; {
            state.write_usize(1);
            value.cache_key(state);
        }
    }
}
</t>
