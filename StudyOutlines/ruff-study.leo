<t tx="ekr.20231231171059.116">/// Escape double quotes (`"`) in `value` using `#quot;`.
fn mermaid_write_quoted_str(f: &amp;mut fmt::Formatter&lt;'_&gt;, value: &amp;str) -&gt; fmt::Result {
    let mut parts = value.split('"');
    if let Some(v) = parts.next() {
        write!(f, "{v}")?;
    }
    for v in parts {
        write!(f, "#quot;{v}")?;
    }
    Ok(())
}
</t>
