<t tx="ekr.20231231171046.20">fn try_from(value: CmpOp) -&gt; Option&lt;EqCmpOp&gt; {
    match value {
        CmpOp::Eq =&gt; Some(EqCmpOp::Eq),
        CmpOp::NotEq =&gt; Some(EqCmpOp::NotEq),
        _ =&gt; None,
    }
