<t tx="ekr.20231231171105.262">/// Returns the index of the operator directly left to this operand. Returns [`None`] if
/// this is the first operand in the call chain.
fn left_operator(self) -&gt; Option&lt;OperatorIndex&gt; {
    if self.0 == 0 {
        None
    } else {
        Some(OperatorIndex::new(self.0 - 1))
    }
}
