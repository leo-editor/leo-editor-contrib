) {
    let node = AnyNodeRef::from(f_string_element);
    if visitor.enter_node(node).is_traverse() {
        match f_string_element {
            FStringElement::Expression(element) =&gt; element.visit_preorder(visitor),
            FStringElement::Literal(element) =&gt; element.visit_preorder(visitor),
        }
    }
    visitor.leave_node(node);
}

