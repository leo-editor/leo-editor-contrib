<t tx="ekr.20231231171102.106">/// Return `true` if the [`Expr`] is a non-singleton constant.
pub fn is_constant_non_singleton(expr: &amp;Expr) -&gt; bool {
    is_constant(expr) &amp;&amp; !is_singleton(expr)
}
