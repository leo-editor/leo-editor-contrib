struct Project {
    #[serde(alias = "requires-python", alias = "requires_python")]
    requires_python: Option&lt;VersionSpecifiers&gt;,
}
</t>
<t tx="ekr.20231231171121.176">#[derive(Debug, PartialEq, Eq, Default, Serialize, Deserialize)]
pub struct Pyproject {
    tool: Option&lt;Tools&gt;,
    project: Option&lt;Project&gt;,
}
</t>
<t tx="ekr.20231231171121.177">impl Pyproject {
    pub const fn new(options: Options) -&gt; Self {
        Self {
            tool: Some(Tools {
                ruff: Some(options),
            }),
            project: None,
        }
    }
}
