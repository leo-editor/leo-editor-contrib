fn contents(contents: &amp;str, snapshot: &amp;str) {
    let diagnostics = test_snippet(
        contents,
        &amp;settings::LinterSettings::for_rules(Linter::PandasVet.rules()),
    );
    assert_messages!(snapshot, diagnostics);
}
