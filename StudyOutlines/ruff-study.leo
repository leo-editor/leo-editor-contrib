<t tx="ekr.20231231171053.13">fn merged_isinstance_call(
    obj: &amp;str,
    types: impl IntoIterator&lt;Item = String&gt;,
    target_version: PythonVersion,
) -&gt; String {
    if target_version &gt;= PythonVersion::Py310 {
        format!("isinstance({}, {})", obj, types.into_iter().join(" | "))
    } else {
        format!("isinstance({}, ({}))", obj, types.into_iter().join(", "))
    }
}
</t>
