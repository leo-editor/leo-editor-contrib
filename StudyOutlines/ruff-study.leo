        let contents = "x = 1
y = 2  # isort: split
z = x + 1";
        let lxr: Vec&lt;LexResult&gt; = lexer::lex(contents, Mode::Module).collect();
        assert_eq!(
            extract_isort_directives(&amp;lxr, &amp;Locator::new(contents)).splits,
