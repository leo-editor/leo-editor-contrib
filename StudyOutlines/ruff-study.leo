<t tx="ekr.20231231171116.100">/// Return `true` if this [`Binding`] is used.
pub fn is_used(&amp;self) -&gt; bool {
    !self.references.is_empty()
}
</t>
<t tx="ekr.20231231171116.101">/// Returns an iterator over all references for the current [`Binding`].
pub fn references(&amp;self) -&gt; impl Iterator&lt;Item = ResolvedReferenceId&gt; + '_ {
    self.references.iter().copied()
}
