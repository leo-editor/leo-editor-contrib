<t tx="ekr.20231231171022.12">/// Create a [`DisplayParseError`] from a [`ParseError`] and a [`SourceKind`].
pub fn from_source_kind(
    error: ParseError,
    path: Option&lt;PathBuf&gt;,
    source_kind: &amp;SourceKind,
) -&gt; Self {
    Self::from_source_code(
        error,
        path,
        &amp;SourceCode::new(
            source_kind.source_code(),
            &amp;LineIndex::from_source_text(source_kind.source_code()),
        ),
        source_kind,
    )
}
</t>
