<t tx="ekr.20231231171115.152">pub(super) fn eat_char2(&amp;mut self, c1: char, c2: char) -&gt; bool {
    let mut chars = self.chars.clone();
    if chars.next() == Some(c1) &amp;&amp; chars.next() == Some(c2) {
        self.bump();
        self.bump();
        true
    } else {
        false
    }
}
</t>
<t tx="ekr.20231231171115.153">pub(super) fn eat_char3(&amp;mut self, c1: char, c2: char, c3: char) -&gt; bool {
    let mut chars = self.chars.clone();
    if chars.next() == Some(c1) &amp;&amp; chars.next() == Some(c2) &amp;&amp; chars.next() == Some(c3) {
        self.bump();
        self.bump();
        self.bump();
        true
    } else {
        false
