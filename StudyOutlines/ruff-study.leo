<t tx="ekr.20231231171036.8">/// PYI009
pub(crate) fn pass_statement_stub_body(checker: &amp;mut Checker, body: &amp;[Stmt]) {
    let [Stmt::Pass(pass)] = body else {
        return;
    };

    let mut diagnostic = Diagnostic::new(PassStatementStubBody, pass.range());
    diagnostic.set_fix(Fix::safe_edit(Edit::range_replacement(
        format!("..."),
        pass.range(),
    )));
    checker.diagnostics.push(diagnostic);
}
