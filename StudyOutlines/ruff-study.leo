<t tx="ekr.20231231171024.265">fn from(rule: Rule) -&gt; Self {
    let code = rule.noqa_code().to_string();
    let (linter, _) = Linter::parse_code(&amp;code).unwrap();
    Self {
        name: rule.into(),
        code,
        linter: linter.name(),
        summary: rule.message_formats()[0],
        explanation: rule.explanation(),
        url: rule.url(),
    }
}
