<t tx="ekr.20231231171024.82">/// Returns `true` if the source code should be truncated when included in a user-facing
/// diagnostic.
fn should_truncate(source_code: &amp;str) -&gt; bool {
    source_code.width() &gt; 50 || source_code.contains(['\r', '\n'])
}
