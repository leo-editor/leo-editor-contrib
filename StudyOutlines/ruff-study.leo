<t tx="ekr.20231231171104.37">/// Change the [`IndentLevel`] of the formatter for the lifetime of this
/// struct.
pub(crate) struct WithIndentLevel&lt;'a, B, D&gt;
where
    D: DerefMut&lt;Target = B&gt;,
    B: Buffer&lt;Context = PyFormatContext&lt;'a&gt;&gt;,
{
    buffer: D,
    saved_level: IndentLevel,
}

impl&lt;'a, B, D&gt; WithIndentLevel&lt;'a, B, D&gt;
where
    D: DerefMut&lt;Target = B&gt;,
    B: Buffer&lt;Context = PyFormatContext&lt;'a&gt;&gt;,
{
    @others
}
</t>
