<t tx="ekr.20231231171121.156">/// Returns the extracted metadata.
fn metadata() -&gt; OptionSet
where
    Self: Sized + 'static,
{
    OptionSet::of::&lt;Self&gt;()
}
</t>
<t tx="ekr.20231231171121.157">fn fmt(&amp;self, f: &amp;mut Formatter&lt;'_&gt;) -&gt; std::fmt::Result {
    match self {
        OptionEntry::Set(set) =&gt; std::fmt::Display::fmt(set, f),
        OptionEntry::Field(field) =&gt; std::fmt::Display::fmt(&amp;field, f),
    }
}
</t>
<t tx="ekr.20231231171121.158">pub fn of&lt;T&gt;() -&gt; Self
where
    T: OptionsMetadata + 'static,
{
    Self {
        record: T::record,
        doc: T::documentation,
    }
}

/// Visits the options in this set by calling `visit` for each option.
pub fn record(&amp;self, visit: &amp;mut dyn Visit) {
    let record = self.record;
    record(visit);
}
</t>
<t tx="ekr.20231231171121.159">pub fn documentation(&amp;self) -&gt; Option&lt;&amp;'static str&gt; {
    let documentation = self.doc;
    documentation()
}
