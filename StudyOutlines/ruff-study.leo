fn global_import_star() {
    // Can't find undefined names with import *.
    flakes(
        "from fu import *; bar",
        &amp;[
            Rule::UndefinedLocalWithImportStar,
            Rule::UndefinedLocalWithImportStarUsage,
        ],
    );
}
