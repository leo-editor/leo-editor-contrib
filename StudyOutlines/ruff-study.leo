    assert!(is_module_name("a_b_c"));
    assert!(is_module_name("abc"));
    assert!(is_module_name("abc0"));
    assert!(is_module_name("abc_"));
    assert!(!is_module_name("0001_initial"));
    assert!(!is_module_name("0abc"));
    assert!(!is_module_name("a-b-c"));
