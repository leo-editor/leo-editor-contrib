<t tx="ekr.20231231171039.22">fn is_one_line_return_bool(stmts: &amp;[Stmt]) -&gt; Option&lt;Bool&gt; {
    let [stmt] = stmts else {
        return None;
    };
    let Stmt::Return(ast::StmtReturn { value, range: _ }) = stmt else {
        return None;
    };
    let Some(Expr::BooleanLiteral(ast::ExprBooleanLiteral { value, .. })) = value.as_deref() else {
        return None;
    };
    Some((*value).into())
}
