<t tx="ekr.20231231171018.222">/// Convert the file cache into `Diagnostics`, using `path` as file name.
pub(crate) fn to_diagnostics(&amp;self, path: &amp;Path) -&gt; Option&lt;Diagnostics&gt; {
    self.data.lint.as_ref().map(|lint| {
        let messages = if lint.messages.is_empty() {
            Vec::new()
        } else {
            let file = SourceFileBuilder::new(path.to_string_lossy(), &amp;*lint.source).finish();
            lint.messages
                .iter()
                .map(|msg| Message {
                    kind: msg.kind.clone(),
                    range: msg.range,
                    fix: msg.fix.clone(),
                    file: file.clone(),
                    noqa_offset: msg.noqa_offset,
                })
                .collect()
        };
        let notebook_indexes = if let Some(notebook_index) = lint.notebook_index.as_ref() {
            FxHashMap::from_iter([(path.to_string_lossy().to_string(), notebook_index.clone())])
        } else {
            FxHashMap::default()
        };
        Diagnostics::new(messages, lint.imports.clone(), notebook_indexes)
    })
}
</t>
<t tx="ekr.20231231171018.223">pub(crate) fn from_messages(
    messages: &amp;[Message],
    imports: ImportMap,
    notebook_index: Option&lt;NotebookIndex&gt;,
) -&gt; Self {
    let source = if let Some(msg) = messages.first() {
        msg.file.source_text().to_owned()
    } else {
        String::new() // No messages, no need to keep the source!
    };

    let messages = messages
        .iter()
        .map(|msg| {
            // Make sure that all message use the same source file.
            assert_eq!(
                msg.file,
                messages.first().unwrap().file,
                "message uses a different source file"
            );
            CacheMessage {
                kind: msg.kind.clone(),
                range: msg.range,
                fix: msg.fix.clone(),
                noqa_offset: msg.noqa_offset,
            }
        })
        .collect();

    Self {
        imports,
        messages,
        source,
        notebook_index,
    }
}
</t>
<t tx="ekr.20231231171018.224">fn get(&amp;self, package_root: &amp;Path) -&gt; Option&lt;&amp;Cache&gt; {
