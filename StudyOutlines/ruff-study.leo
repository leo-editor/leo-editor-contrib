<t tx="ekr.20231231171022.113">type Value = Rule;

fn parse_ref(
    &amp;self,
    cmd: &amp;clap::Command,
    arg: Option&lt;&amp;clap::Arg&gt;,
    value: &amp;std::ffi::OsStr,
) -&gt; Result&lt;Self::Value, clap::Error&gt; {
    let value = value
        .to_str()
        .ok_or_else(|| clap::Error::new(clap::error::ErrorKind::InvalidUtf8))?;

    Rule::from_code(value).map_err(|_| {
        let mut error =
            clap::Error::new(clap::error::ErrorKind::ValueValidation).with_cmd(cmd);
        if let Some(arg) = arg {
            error.insert(
                clap::error::ContextKind::InvalidArg,
                clap::error::ContextValue::String(arg.to_string()),
            );
        }
        error.insert(
            clap::error::ContextKind::InvalidValue,
            clap::error::ContextValue::String(value.to_string()),
        );
        error
    })
}
</t>
<t tx="ekr.20231231171022.114">fn possible_values(&amp;self) -&gt; Option&lt;Box&lt;dyn Iterator&lt;Item = PossibleValue&gt; + '_&gt;&gt; {
    Some(Box::new(Rule::iter().map(|rule| {
        let name = rule.noqa_code().to_string();
        let help = rule.as_ref().to_string();
        PossibleValue::new(name).help(help)
    })))
}
</t>
<t tx="ekr.20231231171022.115">use std::mem::size_of;

use strum::IntoEnumIterator;

use super::{Linter, Rule, RuleNamespace};

#[test]
fn documentation() {
    for rule in Rule::iter() {
        assert!(
            rule.explanation().is_some(),
            "Rule {} is missing documentation",
            rule.as_ref()
        );
    }
}
