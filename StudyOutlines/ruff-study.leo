<t tx="ekr.20231231171022.49">/// Lex a specific character, or return `None` if the character is not the first character in
/// the line.
#[inline]
fn lex_char(line: &amp;str, c: char) -&gt; Option&lt;&amp;str&gt; {
    let mut chars = line.chars();
    if chars.next() == Some(c) {
        Some(chars.as_str())
    } else {
        None
    }
}
