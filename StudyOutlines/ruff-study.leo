<t tx="ekr.20231231171115.79">    #[test]
    fn test_fstring_parse_self_documenting_base() {
        let source = r#"f"{user=}""#;
        let parse_ast = parse_suite(source).unwrap();

        insta::assert_debug_snapshot!(parse_ast);
    }
