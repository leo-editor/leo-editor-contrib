<t tx="ekr.20231231171048.329">#[test]
fn postponed_annotations() {
    flakes(
        r"
    from __future__ import annotations
    def f(a: A) -&gt; A: pass
    class A:
        b: B
    class B: pass
    ",
        &amp;[],
    );

    flakes(
        r"
    from __future__ import annotations
    def f(a: A) -&gt; A: pass
    class A:
        b: Undefined
    class B: pass
    ",
        &amp;[Rule::UndefinedName],
    );

    flakes(
        r"
    from __future__ import annotations
    T: object
    def f(t: T): pass
    def g(t: 'T'): pass
    ",
        &amp;[Rule::UndefinedName, Rule::UndefinedName],
    );

    flakes(
        r"
    from __future__ import annotations
    T = object
    def f(t: T): pass
    def g(t: 'T'): pass
    ",
        &amp;[],
    );
}
</t>
