enum Text&lt;'a&gt; {
    /// ASCII only text that contains no line breaks or tab characters.
    Token(&amp;'a str),
    /// Arbitrary text. May contain `\n` line breaks, tab characters, or unicode characters.
    Text {
        text: &amp;'a str,
        text_width: TextWidth,
    },
}

#[cfg(test)]
