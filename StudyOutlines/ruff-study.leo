<t tx="ekr.20231231171117.172">/// Pushes a new [`ResolvedReference`] and returns its [`ResolvedReferenceId`].
pub(crate) fn push(
    &amp;mut self,
    scope_id: ScopeId,
    node_id: Option&lt;NodeId&gt;,
    range: TextRange,
    flags: SemanticModelFlags,
) -&gt; ResolvedReferenceId {
    self.0.push(ResolvedReference {
        node_id,
        scope_id,
