<t tx="ekr.20231231171115.70">fn from(err: FStringError) -&gt; Self {
    lalrpop_util::ParseError::User {
        error: LexicalError {
            error: LexicalErrorType::FStringError(err.error),
            location: err.location,
        },
    }
}
