        While =&gt; f.write_str("'while'"),
        Match =&gt; f.write_str("'match'"),
        Type =&gt; f.write_str("'type'"),
        Case =&gt; f.write_str("'case'"),
        With =&gt; f.write_str("'with'"),
        Yield =&gt; f.write_str("'yield'"),
        ColonEqual =&gt; f.write_str("':='"),
    }
