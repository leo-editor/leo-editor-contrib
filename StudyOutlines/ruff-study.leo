<t tx="ekr.20231231171121.171">fn record_set(&amp;mut self, name: &amp;str, set: OptionSet) {
    if self.option.is_none() &amp;&amp; name == self.needle {
        if let Some(next) = self.parts.next() {
            self.needle = next;
            set.record(self);
        } else {
            self.option = Some(OptionEntry::Set(set));
        }
    }
}
</t>
<t tx="ekr.20231231171121.172">fn record_field(&amp;mut self, name: &amp;str, field: OptionField) {
    if self.option.is_none() &amp;&amp; name == self.needle {
        if self.parts.next().is_none() {
            self.option = Some(OptionEntry::Field(field));
        }
    }
}
