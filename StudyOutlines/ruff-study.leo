pub(crate) fn set_source(&amp;mut self, source: SourceValue) {
    match self {
        Cell::Code(cell) =&gt; cell.source = source,
        Cell::Markdown(cell) =&gt; cell.source = source,
        Cell::Raw(cell) =&gt; cell.source = source,
