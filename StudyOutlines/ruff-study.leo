<t tx="ekr.20231231171022.39">impl FromIterator&lt;TextRange&gt; for NoqaMapping {
    fn from_iter&lt;T: IntoIterator&lt;Item = TextRange&gt;&gt;(iter: T) -&gt; Self {
        let mut mappings = NoqaMapping::default();

        for range in iter {
