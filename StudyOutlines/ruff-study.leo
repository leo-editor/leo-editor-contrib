<t tx="ekr.20231231171020.10">fn format_tab(tab_name: &amp;str, header: &amp;str, content: &amp;str) -&gt; String {
    format!(
        "=== \"{}\"\n\n    ```toml\n    {}\n{}\n    ```\n",
