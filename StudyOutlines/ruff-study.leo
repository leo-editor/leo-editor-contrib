<t tx="ekr.20231231171024.110">pub(crate) fn new(
    python_ast: &amp;'a [Stmt],
    locator: &amp;'a Locator&lt;'a&gt;,
    stylist: &amp;'a Stylist&lt;'a&gt;,
) -&gt; Self {
    Self {
        python_ast,
        locator,
        stylist,
        runtime_imports: Vec::default(),
        type_checking_blocks: Vec::default(),
    }
}
