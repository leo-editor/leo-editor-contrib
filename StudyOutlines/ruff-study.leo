<t tx="ekr.20231231171059.147">#[derive(Debug, PartialEq, Eq)]
pub struct UnusedCodes {
    pub unknown: Vec&lt;String&gt;,
    pub disabled: Vec&lt;String&gt;,
    pub unmatched: Vec&lt;String&gt;,
}
