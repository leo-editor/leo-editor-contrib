fn is_async_iterator(arguments: Option&lt;&amp;Arguments&gt;, semantic: &amp;SemanticModel) -&gt; bool {
    let Some(Arguments { args: bases, .. }) = arguments else {
        return false;
    };
    bases.iter().any(|expr| {
        semantic
            .resolve_call_path(map_subscript(expr))
            .is_some_and(|call_path| {
