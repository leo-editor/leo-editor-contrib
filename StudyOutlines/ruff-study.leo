<t tx="ekr.20231231171054.35">fn visit_expr(&amp;mut self, expr: &amp;'a Expr) {
    if let Expr::Name(expr_name) = expr {
        self.names.push(expr_name);
    }
    visitor::walk_expr(self, expr);
}
