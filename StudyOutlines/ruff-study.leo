<t tx="ekr.20231231171050.85">/// PLE1142
pub(crate) fn await_outside_async(checker: &amp;mut Checker, expr: &amp;Expr) {
    if !checker.semantic().in_async_context() {
        checker
            .diagnostics
            .push(Diagnostic::new(AwaitOutsideAsync, expr.range()));
    }
}
