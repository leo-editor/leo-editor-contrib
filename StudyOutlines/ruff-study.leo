<t tx="ekr.20231231171101.146">/// Jupyter Notebook indexing table
///
/// When we lint a jupyter notebook, we have to translate the row/column based on
/// [`ruff_text_size::TextSize`] to jupyter notebook cell/row/column.
#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
pub struct NotebookIndex {
    /// Enter a row (1-based), get back the cell (1-based)
    pub(super) row_to_cell: Vec&lt;OneIndexed&gt;,
    /// Enter a row (1-based), get back the row in cell (1-based)
    pub(super) row_to_row_in_cell: Vec&lt;OneIndexed&gt;,
}
</t>
<t tx="ekr.20231231171101.147">impl NotebookIndex {
    @others
}
</t>
<t tx="ekr.20231231171101.148">pub fn new(row_to_cell: Vec&lt;OneIndexed&gt;, row_to_row_in_cell: Vec&lt;OneIndexed&gt;) -&gt; Self {
    Self {
        row_to_cell,
        row_to_row_in_cell,
    }
}
</t>
<t tx="ekr.20231231171101.149">/// Returns the cell number (1-based) for the given row (1-based).
pub fn cell(&amp;self, row: OneIndexed) -&gt; Option&lt;OneIndexed&gt; {
    self.row_to_cell.get(row.to_zero_indexed()).copied()
}
</t>
<t tx="ekr.20231231171101.15">fn record(visit: &amp;mut dyn crate::options_base::Visit) {
    #(#output);*
}
