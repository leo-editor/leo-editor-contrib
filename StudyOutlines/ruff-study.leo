<t tx="ekr.20231231171105.203">/// Makes `comment` a [leading comment](self#leading-comments) of `node`.
#[inline]
pub(super) fn leading(node: impl Into&lt;AnyNodeRef&lt;'a&gt;&gt;, comment: DecoratedComment) -&gt; Self {
    Self::Leading {
        node: node.into(),
        comment: comment.into(),
