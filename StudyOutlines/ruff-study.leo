<t tx="ekr.20231231171102.799">fn cast(kind: AnyNode) -&gt; Option&lt;Self&gt;
where
    Self: Sized,
{
    if let AnyNode::ExceptHandlerExceptHandler(node) = kind {
        Some(node)
