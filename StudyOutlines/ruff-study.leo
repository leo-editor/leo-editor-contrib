<t tx="ekr.20231231171102.1606">/// Returns the length of the concatenated bytes.
pub fn len(&amp;self) -&gt; usize {
    self.iter().map(|part| part.len()).sum()
}
</t>
<t tx="ekr.20231231171102.1607">/// Returns an iterator over the bytes of the concatenated bytes.
fn bytes(&amp;self) -&gt; impl Iterator&lt;Item = u8&gt; + '_ {
    self.iter().flat_map(|part| part.as_slice().iter().copied())
}
</t>
<t tx="ekr.20231231171102.1608">type Item = &amp;'a BytesLiteral;
