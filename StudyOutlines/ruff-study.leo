<t tx="ekr.20231231171037.176">fn assert(expr: &amp;Expr, msg: Option&lt;&amp;Expr&gt;) -&gt; Stmt {
    Stmt::Assert(ast::StmtAssert {
        test: Box::new(expr.clone()),
        msg: msg.map(|msg| Box::new(msg.clone())),
        range: TextRange::default(),
    })
}
</t>
<t tx="ekr.20231231171037.177">fn compare(left: &amp;Expr, cmp_op: CmpOp, right: &amp;Expr) -&gt; Expr {
    Expr::Compare(ast::ExprCompare {
        left: Box::new(left.clone()),
        ops: vec![cmp_op],
        comparators: vec![right.clone()],
        range: TextRange::default(),
    })
}
