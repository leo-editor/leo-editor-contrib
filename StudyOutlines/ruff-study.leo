<t tx="ekr.20231231171103.208">fn from(stylist: &amp;'a Stylist&lt;'a&gt;) -&gt; Self {
    Self {
        indent: stylist.indentation(),
        quote: stylist.quote(),
        line_ending: stylist.line_ending(),
        buffer: String::new(),
        indent_depth: 0,
        num_newlines: 0,
        initial: true,
    }
}
</t>
<t tx="ekr.20231231171103.209">pub const fn new(indent: &amp;'a Indentation, quote: Quote, line_ending: LineEnding) -&gt; Self {
    Self {
        // Style preferences.
        indent,
        quote,
        line_ending,
        // Internal state.
        buffer: String::new(),
        indent_depth: 0,
        num_newlines: 0,
        initial: true,
    }
}

/// Generate source code from a [`Stmt`].
pub fn stmt(mut self, stmt: &amp;Stmt) -&gt; String {
    self.unparse_stmt(stmt);
    self.generate()
}
