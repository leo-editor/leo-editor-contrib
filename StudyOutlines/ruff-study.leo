<t tx="ekr.20231231171048.27">const FIX_AVAILABILITY: FixAvailability = FixAvailability::Sometimes;

#[derive_message_formats]
fn message(&amp;self) -&gt; String {
    format!("One-line docstring should fit on one line")
}
