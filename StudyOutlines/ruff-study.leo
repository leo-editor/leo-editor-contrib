<t tx="ekr.20231231171116.125">/// ID uniquely identifying a branch in a program.
///
/// For example, given:
/// ```python
/// if x &gt; 0:
///     pass
/// elif x &gt; 1:
///     pass
/// else:
///     pass
/// ```
///
/// Each of the three arms of the `if`-`elif`-`else` would be considered a branch, and would be
/// assigned their own unique [`BranchId`].
#[newtype_index]
#[derive(Ord, PartialOrd)]
pub struct BranchId;

/// The branches of a program indexed by [`BranchId`]
#[derive(Debug, Default)]
pub(crate) struct Branches(IndexVec&lt;BranchId, Option&lt;BranchId&gt;&gt;);

impl Branches {
    @others
}
</t>
<t tx="ekr.20231231171116.126">impl Index&lt;BranchId&gt; for Branches {
    @others
}
</t>
<t tx="ekr.20231231171116.127">/// Inserts a new branch into the vector and returns its unique [`BranchID`].
pub(crate) fn insert(&amp;mut self, parent: Option&lt;BranchId&gt;) -&gt; BranchId {
    self.0.push(parent)
}
</t>
<t tx="ekr.20231231171116.128">/// Return the [`BranchId`] of the parent branch.
#[inline]
pub(crate) fn parent_id(&amp;self, node_id: BranchId) -&gt; Option&lt;BranchId&gt; {
    self.0[node_id]
}
</t>
<t tx="ekr.20231231171116.129">/// Returns an iterator over all [`BranchId`] ancestors, starting from the given [`BranchId`].
pub(crate) fn ancestor_ids(&amp;self, node_id: BranchId) -&gt; impl Iterator&lt;Item = BranchId&gt; + '_ {
    std::iter::successors(Some(node_id), |&amp;node_id| self.0[node_id])
}
</t>
