<t tx="ekr.20231231171037.215">/// Update the context to not check for escaped quotes, and clear any
/// existing reported ranges.
fn ignore_escaped_quotes(&amp;mut self) {
    self.check_for_escaped_quote = false;
    self.middle_ranges_with_escapes.clear();
}
</t>
<t tx="ekr.20231231171037.216">fn push_fstring_middle_range(&amp;mut self, range: TextRange) {
    self.middle_ranges_with_escapes.push(range);
}
