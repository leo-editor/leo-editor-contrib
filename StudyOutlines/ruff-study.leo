    ",
        &amp;[Rule::FutureFeatureNotDefined],
    );
}
</t>
<t tx="ekr.20231231171048.297">#[test]
fn ignored_in_function() {
    // An C{__all__} definition does not suppress unused import warnings in a
    // function scope.
    flakes(
        r#"
    def foo():
        import bar
        __all__ = ["bar"]
    "#,
        &amp;[Rule::UnusedImport, Rule::UnusedVariable],
    );
}
</t>
<t tx="ekr.20231231171048.298">#[test]
fn ignored_in_class() {
    // An C{__all__} definition in a class does not suppress unused import warnings.
    flakes(
        r#"
    import bar
    class foo:
        __all__ = ["bar"]
    "#,
        &amp;[Rule::UnusedImport],
    );
}
</t>
<t tx="ekr.20231231171048.299">#[test]
fn ignored_when_not_directly_assigned() {
    flakes(
        r#"
