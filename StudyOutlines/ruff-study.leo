<t tx="ekr.20231231171021.439">pub fn is_excluded(&amp;self, offset: TextSize) -&gt; bool {
    for range in &amp;self.exclusions {
        if range.contains(offset) {
            return true;
        }

        if range.start() &gt; offset {
            break;
        }
    }

    false
}
