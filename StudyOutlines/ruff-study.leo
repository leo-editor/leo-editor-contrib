<t tx="ekr.20231231171050.117">pub(crate) fn for_strip(s: StripKind) -&gt; Option&lt;Self&gt; {
    match s {
        StripKind::Strip =&gt; None,
        StripKind::LStrip =&gt; Some(Self::RemovePrefix),
        StripKind::RStrip =&gt; Some(Self::RemoveSuffix),
    }
}
