        let lexed: Vec&lt;_&gt; = lex(source, Mode::Module).collect();

        match lexed.as_slice() {
            [Err(error)] =&gt; {
                assert_eq!(
                    error.error,
                    LexicalErrorType::UnrecognizedToken { tok: '🐦' }
