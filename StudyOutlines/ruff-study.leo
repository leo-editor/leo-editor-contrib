<t tx="ekr.20231231171059.38">use crate::checkers::ast::Checker;
use crate::rules::ruff::rules::helpers::{
    has_default_copy_semantics, is_class_var_annotation, is_dataclass, is_final_annotation,
    is_special_attribute,
};
