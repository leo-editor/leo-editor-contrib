<t tx="ekr.20231231171021.369">type IntoIter = std::slice::IterMut&lt;'a, T&gt;;
type Item = &amp;'a mut T;

#[inline]
fn into_iter(self) -&gt; std::slice::IterMut&lt;'a, T&gt; {
    self.iter_mut()
}
