<t tx="ekr.20231231171042.154">#[derive_message_formats]
fn message(&amp;self) -&gt; String {
    let ComplexStructure {
        name,
        complexity,
        max_complexity,
    } = self;
    format!("`{name}` is too complex ({complexity} &gt; {max_complexity})")
}
