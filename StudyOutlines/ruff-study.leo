            value: value.as_str(),
        }),
        ast::Stmt::Expr(ast::StmtExpr { value, range: _ }) =&gt; Self::Expr(StmtExpr {
            value: value.into(),
        }),
        ast::Stmt::Pass(_) =&gt; Self::Pass,
        ast::Stmt::Break(_) =&gt; Self::Break,
        ast::Stmt::Continue(_) =&gt; Self::Continue,
    }
}
