<t tx="ekr.20231110140256.1">// https://doc.rust-lang.org/stable/book/ch10-02-traits.html

#[macro_use]
extern crate fstrings;

// Define signatures:

pub trait Summary {
    fn summarize(&amp;self) -&gt; String;
}

// Default implementation:

pub trait Summary {
    fn summarize(&amp;self) -&gt; String {
        String::from("(Read more...)")
    }
}

// Default implementations can call other methods in the same crate:
// (Even if those other methods don't have a default implementation!)

pub trait Summary {
    fn summarize_author(&amp;self) -&gt; String;  // EKR: no default implementation.

    fn summarize(&amp;self) -&gt; String {
        // format!("(Read more from {}...)", self.summarize_author())
        f!("(Read more from {self.summarize_author()}...)")
    }
}

// Must provide summarize_author for each type:

impl Summary for Tweet {
    fn summarize_author(&amp;self) -&gt; String {
        // format!("@{}", self.username)
        f!("@{self.username}")
    }
}

// Implementations of sSummary for two structs:

impl Summary for NewsArticle {
    fn summarize(&amp;self) -&gt; String {
        // format!("{}, by {} ({})", self.headline, self.author, self.location)
        f!("{self.headline}, by {self.author} ({self.location})")
    }
}

impl Summary for Tweet {
    fn summarize(&amp;self) -&gt; String {
        // format!("{}: {}", self.username, self.content)
        f!("{self.username}: {self.content}")
    }
}
</t>
<t tx="ekr.20231110140306.1">// https://doc.rust-lang.org/stable/book/ch10-02-traits.html#traits-as-parameters

pub fn notify(item: &amp;impl Summary) {
    println_f!("Breaking news! {item.summarize()}");
}

// *** Trait bound syntax.

// The impl Trait syntax is syntax sugar for a longer form known as a trait bound:

pub fn notify&lt;T: Summary&gt;(item: &amp;T) {
    println_f!("Breaking news! {item.summarize()}");
}

// *** Multiple trait bounds.

pub fn notify(item: &amp;(impl Summary + Display)) {...}

pub fn notify&lt;T: Summary + Display&gt;(item: &amp;T) {...}

// *** Where clauses.

fn some_function&lt;T: Display + Clone, U: Clone + Debug&gt;(t: &amp;T, u: &amp;U) -&gt; i32 {...}

fn some_function&lt;T, U&gt;(t: &amp;T, u: &amp;U) -&gt; i32
where
    T: Display + Clone,
    U: Clone + Debug,
{...}


// *** Returning traits (types that implement traits) 

fn returns_summarizable() -&gt; impl Summary {...}

// Note: You can only use impl Trait if you’re returning a single type.


// *** Using Trait Bounds to Conditionally Implement Methods

// We can implement methods conditionally for types that implement the specified traits. 

use std::fmt::Display;

struct Pair&lt;T&gt; {
    x: T,
    y: T,
}

impl&lt;T&gt; Pair&lt;T&gt; {
    fn new(x: T, y: T) -&gt; Self {
        Self { x, y }
    }
}

impl&lt;T: Display + PartialOrd&gt; Pair&lt;T&gt; {
    fn cmp_display(&amp;self) {
        let largest = if x &gt;= y { x } else { y };
        println_f!("The largest member is x = {largest}");
        // if self.x &gt;= self.y {
            // println_f!("The largest member is x = {self.x}");
        // } else {
            // println_f!("The largest member is y = {self.y}");
        // }
    }
}



