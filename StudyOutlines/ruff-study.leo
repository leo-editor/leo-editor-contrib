<t tx="ekr.20231231171102.110">/// Given an [`Expr`] that can be starred, return the underlying starred expression.
pub fn map_starred(expr: &amp;Expr) -&gt; &amp;Expr {
    if let Expr::Starred(ast::ExprStarred { value, .. }) = expr {
        // Ex) `*args`
        value
    } else {
        // Ex) `args`
        expr
    }
}
