pub fn as_class_def(&amp;self) -&gt; Option&lt;&amp;ast::StmtClassDef&gt; {
    match self {
        Definition::Member(Member {
            kind: MemberKind::Class(class) | MemberKind::NestedClass(class),
            ..
        }) =&gt; Some(class),
