<t tx="ekr.20231231171058.83">/// Returns the replacement comparison operator for this membership test.
fn replacement_op(self) -&gt; CmpOp {
    match self {
        MembershipTest::In =&gt; CmpOp::Eq,
        MembershipTest::NotIn =&gt; CmpOp::NotEq,
    }
}
