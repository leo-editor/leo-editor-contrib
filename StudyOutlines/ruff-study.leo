<t tx="ekr.20231231171051.23">fn into_unary(self) -&gt; &amp;'static str {
    match self {
        Self::Is | Self::Eq =&gt; "not ",
        Self::IsNot | Self::NotEq =&gt; "",
    }
}
</t>
<t tx="ekr.20231231171051.24">fn fmt(&amp;self, f: &amp;mut std::fmt::Formatter&lt;'_&gt;) -&gt; std::fmt::Result {
    let repr = match self {
        Self::Is =&gt; "is",
        Self::IsNot =&gt; "is not",
        Self::Eq =&gt; "==",
        Self::NotEq =&gt; "!=",
    };
    write!(f, "{repr}")
}
