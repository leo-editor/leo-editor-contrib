<t tx="ekr.20231231171020.318">/// Sets a `condition` to when the content should fit in expanded mode. The content uses the regular fits
/// definition if the `condition` is not met.
#[must_use]
pub fn with_condition(mut self, condition: Option&lt;Condition&gt;) -&gt; Self {
    self.condition = condition;
    self
}
