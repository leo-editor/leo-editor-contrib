pub fn innermost(&amp;self, offset: TextSize) -&gt; Option&lt;TextRange&gt; {
    self.raw
        .range(..=offset)
        .rev()
        .find(|(_, range)| range.contains(offset))
        .map(|(_, range)| *range)
