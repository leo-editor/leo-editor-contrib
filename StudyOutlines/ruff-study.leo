<t tx="ekr.20231231171101.370">/// Replace any non-whitespace characters from an indentation string within a Python docstring.
pub fn clean_space(indentation: &amp;str) -&gt; String {
    indentation
        .chars()
        .map(|char| if char.is_whitespace() { char } else { ' ' })
        .collect()
}
