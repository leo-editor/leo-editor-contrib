    cell_offsets: Option&lt;Peekable&lt;slice::Iter&lt;'a, TextSize&gt;&gt;&gt;,
    exclusions: &amp;'a [TextRange],
    nested: bool,
}

impl&lt;'a&gt; BlockBuilder&lt;'a&gt; {
