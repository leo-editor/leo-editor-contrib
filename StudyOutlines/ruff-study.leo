fn always_breaks(stmts: &amp;[Stmt]) -&gt; bool {
    for stmt in stmts {
        match stmt {
            Stmt::Break(_) =&gt; return true,
            Stmt::Return(_) =&gt; return false,
            Stmt::Raise(_) =&gt; return false,
            _ =&gt; {}
