<t tx="ekr.20231231171059.112">/// Returns true if `stmts` need a next block, false otherwise.
fn needs_next_block(stmts: &amp;[Stmt]) -&gt; bool {
    // No statements, we automatically continue with the next block.
    let Some(last) = stmts.last() else {
        return true;
    };

    match last {
        Stmt::Return(_) | Stmt::Raise(_) =&gt; false,
        Stmt::If(stmt) =&gt; needs_next_block(&amp;stmt.body) || stmt.elif_else_clauses.last().map_or(true, |clause| needs_next_block(&amp;clause.body)),
        Stmt::FunctionDef(_)
        | Stmt::Import(_)
        | Stmt::ImportFrom(_)
        | Stmt::ClassDef(_)
        | Stmt::Global(_)
        | Stmt::Nonlocal(_)
        | Stmt::Delete(_)
        | Stmt::Assign(_)
        | Stmt::AugAssign(_)
        | Stmt::AnnAssign(_)
        | Stmt::Expr(_)
        | Stmt::Pass(_)
        | Stmt::TypeAlias(_)
        | Stmt::IpyEscapeCommand(_)
        // TODO: check below.
        | Stmt::Break(_)
        | Stmt::Continue(_)
        | Stmt::For(_)
        | Stmt::While(_)
        | Stmt::With(_)
        | Stmt::Match(_)
        | Stmt::Try(_)
        | Stmt::Assert(_) =&gt; true,
    }
}
</t>
<t tx="ekr.20231231171059.113">/// Returns true if `stmt` contains a control flow statement, e.g. an `if` or
/// `return` statement.
fn is_control_flow_stmt(stmt: &amp;Stmt) -&gt; bool {
    match stmt {
        Stmt::FunctionDef(_)
        | Stmt::Import(_)
        | Stmt::ImportFrom(_)
        | Stmt::ClassDef(_)
        | Stmt::Global(_)
        | Stmt::Nonlocal(_)
        | Stmt::Delete(_)
        | Stmt::Assign(_)
        | Stmt::AugAssign(_)
        | Stmt::AnnAssign(_)
        | Stmt::Expr(_)
        | Stmt::TypeAlias(_)
        | Stmt::IpyEscapeCommand(_)
        | Stmt::Pass(_) =&gt; false,
        Stmt::Return(_)
        | Stmt::For(_)
        | Stmt::While(_)
        | Stmt::If(_)
        | Stmt::With(_)
        | Stmt::Match(_)
        | Stmt::Raise(_)
        | Stmt::Try(_)
        | Stmt::Assert(_)
        | Stmt::Break(_)
        | Stmt::Continue(_) =&gt; true,
    }
}
</t>
