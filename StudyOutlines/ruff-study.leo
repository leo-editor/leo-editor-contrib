<t tx="ekr.20231231171117.43">fn visit_stmt(&amp;mut self, stmt: &amp;'a Stmt) {
    match stmt {
        Stmt::Global(ast::StmtGlobal { names, range: _ }) =&gt; {
            for name in names {
                self.0.insert(name.as_str(), name.range());
            }
        }
        Stmt::FunctionDef(_) | Stmt::ClassDef(_) =&gt; {
            // Don't recurse.
        }
        _ =&gt; walk_stmt(self, stmt),
    }
}
</t>
