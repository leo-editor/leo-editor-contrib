<t tx="ekr.20231231171055.13">/// Generate a `Fix` to convert a `NamedTuple` assignment to a class definition.
fn convert_to_class(
    stmt: &amp;Stmt,
    typename: &amp;str,
    body: Vec&lt;Stmt&gt;,
    base_class: &amp;Expr,
    generator: Generator,
) -&gt; Fix {
    Fix::safe_edit(Edit::range_replacement(
        generator.stmt(&amp;create_class_def_stmt(typename, body, base_class)),
        stmt.range(),
    ))
}
</t>
