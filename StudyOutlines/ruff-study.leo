<t tx="ekr.20231231171025.39">pub(super) fn is_sys(expr: &amp;Expr, target: &amp;str, semantic: &amp;SemanticModel) -&gt; bool {
    semantic
        .resolve_call_path(expr)
        .is_some_and(|call_path| call_path.as_slice() == ["sys", target])
}
