<t tx="ekr.20231231171059.119">/// Create a new `Bitmap` with `capacity` capacity.
fn with_capacity(capacity: usize) -&gt; Bitmap {
    let mut size = capacity / usize::BITS as usize;
    if (capacity % usize::BITS as usize) != 0 {
        size += 1;
    }
    Bitmap {
        bits: vec![0; size].into_boxed_slice(),
        capacity,
    }
}
</t>
<t tx="ekr.20231231171059.12">#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum ConversionType {
    /// Conversion using the `|` operator e.g., `str | None`
    BinOpOr,
    /// Conversion using the `typing.Optional` type e.g., `typing.Optional[str]`
    Optional,
}
