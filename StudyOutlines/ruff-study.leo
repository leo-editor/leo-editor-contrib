    semantic: &amp;'a SemanticModel&lt;'b&gt;,
    extend_immutable_calls: &amp;'a [CallPath&lt;'b&gt;],
    diagnostics: Vec&lt;(DiagnosticKind, TextRange)&gt;,
}
</t>
