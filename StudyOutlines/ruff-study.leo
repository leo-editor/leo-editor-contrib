<t tx="ekr.20231231171021.239">fn pop(&amp;mut self) -&gt; Option&lt;&amp;'a FormatElement&gt; {
    let elements = self.element_slices.last_mut()?;
    elements.next().or_else(|| {
        self.element_slices.pop();
        let elements = self.element_slices.last_mut()?;
        elements.next()
    })
}
