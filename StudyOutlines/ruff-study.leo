<t tx="ekr.20231231171019.19">fn rewrite_legacy_subcommand(cmd: &amp;str) -&gt; &amp;str {
    match cmd {
        "--explain" =&gt; "rule",
        "--clean" =&gt; "clean",
        "--generate-shell-completion" =&gt; "generate-shell-completion",
        cmd =&gt; cmd,
    }
}
