<t tx="ekr.20231231171022.166">#[cfg(not(fuzzing))]
pub(crate) fn test_resource_path(path: impl AsRef&lt;Path&gt;) -&gt; std::path::PathBuf {
    Path::new("./resources/test/").join(path)
}
