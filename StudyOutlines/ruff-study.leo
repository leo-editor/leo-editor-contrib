<t tx="ekr.20231231171105.156">/// Creates a key for a node reference.
pub(super) const fn from_ref(node: AnyNodeRef&lt;'a&gt;) -&gt; Self {
    Self { node }
}

/// Returns the underlying node.
pub(super) fn node(&amp;self) -&gt; AnyNodeRef {
    self.node
