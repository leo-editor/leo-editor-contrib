        MemberKind::NestedClass(class) =&gt; &amp;class.body,
        MemberKind::Function(function) =&gt; &amp;function.body,
        MemberKind::NestedFunction(function) =&gt; &amp;function.body,
        MemberKind::Method(method) =&gt; &amp;method.body,
