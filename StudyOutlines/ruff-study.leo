<t tx="ekr.20231231171051.22">type Error = anyhow::Error;

fn try_from(value: &amp;CmpOp) -&gt; Result&lt;Self, Self::Error&gt; {
    match value {
        CmpOp::Is =&gt; Ok(Self::Is),
        CmpOp::IsNot =&gt; Ok(Self::IsNot),
        CmpOp::Eq =&gt; Ok(Self::Eq),
        CmpOp::NotEq =&gt; Ok(Self::NotEq),
        _ =&gt; bail!("{value:?} cannot be converted to EmptyStringCmpOp"),
    }
}
