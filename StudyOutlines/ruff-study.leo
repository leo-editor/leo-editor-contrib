<t tx="ekr.20231116054357.1">@language python
# create a summarize command: https://github.com/leo-editor/leo-editor/issues/3649
g.cls()
import re
pattern_s = r'\bsettings\.\w+'
re_pattern = re.compile(pattern_s)
results = set()
for v in c.all_unique_nodes():
    for m in re.finditer(re_pattern, v.b):
        results.add(m.group(0))

results = list(sorted(results))

# Create top-level summary node.
last = c.lastTopLevel()
p = last.insertAfter()
p.h = f"Summary: {pattern_s}"
results_s = '\n'.join(results)
p.b = f"Summary: {pattern_s}\n\n{results_s}\n"
c.redraw()
</t>
<t tx="ekr.20231116072010.1">@language python

import re

def callback(**kwargs):
    
    # Get and check pattern
    pattern_s = kwargs ['args'][0]
    if not pattern_s.strip():
        g.es_print('No pattern')
        return
    try:
        re_pattern = re.compile(pattern_s)
    except Exception:
        g.es_print(f"Bad pattern: {pattern_s!r}")
        return
    
    # Find all unique instances of pattern.
    results = set()
    for v in c.all_unique_nodes():
        for m in re.finditer(re_pattern, v.b):
            results.add(m.group(1) if m.groups() else m.group(0))
    results = list(sorted(results))
    # Create top-level summary node.
    last = c.lastTopLevel()
    p = last.insertAfter()
    p.h = f"Summary: {pattern_s}"
    results_s = '\n'.join(results)
    p.b = f"// Summary: {pattern_s}\n\n{results_s}\n"
    print(f"Summary: Found {len(results)}")
    c.redraw()

c.interactive1(callback, event=None, prompts=('Summarize regex: ',))</t>
