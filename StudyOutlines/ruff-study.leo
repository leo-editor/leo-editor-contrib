<t tx="ekr.20231231171119.10">/// Returns `true` if a call path represents a function from the Python standard library that
/// returns a mutable value (e.g., `dict`).
pub fn is_mutable_return_type(call_path: &amp;[&amp;str]) -&gt; bool {
    matches!(
        call_path,
        ["", "dict" | "list" | "set"]
            | [
                "collections",
                "Counter" | "OrderedDict" | "defaultdict" | "deque"
            ]
    )
}
