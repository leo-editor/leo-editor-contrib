<t tx="ekr.20231231171117.148">/// Inserts a new AST node into the tree and returns its unique ID.
pub(crate) fn insert(
    &amp;mut self,
    node: NodeRef&lt;'a&gt;,
    parent: Option&lt;NodeId&gt;,
    branch: Option&lt;BranchId&gt;,
) -&gt; NodeId {
    self.nodes.push(NodeWithParent {
        node,
        parent,
        branch,
    })
}
</t>
<t tx="ekr.20231231171117.149">/// Return the [`NodeId`] of the parent node.
#[inline]
pub fn parent_id(&amp;self, node_id: NodeId) -&gt; Option&lt;NodeId&gt; {
    self.nodes[node_id].parent
}
</t>
<t tx="ekr.20231231171117.15">pub fn path(&amp;self) -&gt; Option&lt;&amp;'a [String]&gt; {
    if let ModuleSource::Path(path) = self.source {
        Some(path)
    } else {
        None
    }
}
</t>
<t tx="ekr.20231231171117.150">/// Return the [`BranchId`] of the branch node.
#[inline]
pub(crate) fn branch_id(&amp;self, node_id: NodeId) -&gt; Option&lt;BranchId&gt; {
    self.nodes[node_id].branch
}
</t>
<t tx="ekr.20231231171117.151">/// Returns an iterator over all [`NodeId`] ancestors, starting from the given [`NodeId`].
pub(crate) fn ancestor_ids(&amp;self, node_id: NodeId) -&gt; impl Iterator&lt;Item = NodeId&gt; + '_ {
    std::iter::successors(Some(node_id), |&amp;node_id| self.nodes[node_id].parent)
}
</t>
<t tx="ekr.20231231171117.152">type Output = NodeRef&lt;'a&gt;;

#[inline]
fn index(&amp;self, index: NodeId) -&gt; &amp;Self::Output {
    &amp;self.nodes[index].node
}
</t>
<t tx="ekr.20231231171117.153">/// Returns the [`Stmt`] if this is a statement, or `None` if the reference is to another
/// kind of AST node.
pub fn as_statement(&amp;self) -&gt; Option&lt;&amp;'a Stmt&gt; {
    match self {
        NodeRef::Stmt(stmt) =&gt; Some(stmt),
        NodeRef::Expr(_) =&gt; None,
    }
}
</t>
<t tx="ekr.20231231171117.154">/// Returns the [`Expr`] if this is a expression, or `None` if the reference is to another
/// kind of AST node.
pub fn as_expression(&amp;self) -&gt; Option&lt;&amp;'a Expr&gt; {
    match self {
        NodeRef::Stmt(_) =&gt; None,
        NodeRef::Expr(expr) =&gt; Some(expr),
    }
}
</t>
<t tx="ekr.20231231171117.155">pub fn is_statement(&amp;self) -&gt; bool {
    self.as_statement().is_some()
}
</t>
<t tx="ekr.20231231171117.156">pub fn is_expression(&amp;self) -&gt; bool {
    self.as_expression().is_some()
}
</t>
<t tx="ekr.20231231171117.157">fn range(&amp;self) -&gt; TextRange {
    match self {
        NodeRef::Stmt(stmt) =&gt; stmt.range(),
        NodeRef::Expr(expr) =&gt; expr.range(),
    }
}
</t>
<t tx="ekr.20231231171117.158">fn from(expr: &amp;'a Expr) -&gt; Self {
    NodeRef::Expr(expr)
}
</t>
<t tx="ekr.20231231171117.159">fn from(stmt: &amp;'a Stmt) -&gt; Self {
    NodeRef::Stmt(stmt)
}
</t>
<t tx="ekr.20231231171117.16">/// Return the name of the module.
pub fn name(&amp;self) -&gt; Option&lt;&amp;'a str&gt; {
    match self.source {
        ModuleSource::Path(path) =&gt; path.last().map(Deref::deref),
        ModuleSource::File(file) =&gt; file.file_stem().and_then(std::ffi::OsStr::to_str),
    }
}
</t>
