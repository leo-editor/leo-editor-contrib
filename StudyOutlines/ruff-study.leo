        ast::TypeParam::TypeVarTuple(ast::TypeParamTypeVarTuple { name, range: _ }) =&gt; {
            Self::TypeVarTuple(TypeParamTypeVarTuple {
                name: name.as_str(),
            })
        }
        ast::TypeParam::ParamSpec(ast::TypeParamParamSpec { name, range: _ }) =&gt; {
            Self::ParamSpec(TypeParamParamSpec {
                name: name.as_str(),
            })
        }
    }
}
