<t tx="ekr.20231231171113.116">pub fn write(&amp;self, formatter: &amp;mut impl std::fmt::Write) -&gt; std::fmt::Result {
    let quote = self.0.layout().quote.to_char();
    formatter.write_char('b')?;
    formatter.write_char(quote)?;
    self.0.write_body(formatter)?;
    formatter.write_char(quote)
}
</t>
<t tx="ekr.20231231171113.117">pub fn to_string(&amp;self) -&gt; Option&lt;String&gt; {
