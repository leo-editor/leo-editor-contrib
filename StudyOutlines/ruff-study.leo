#[test]
fn test_has_parentheses() {
    let expression = r#"(b().c("")).d()"#;
    let expr = parse_expression(expression).unwrap();
    assert!(!is_expression_parenthesized(
        ExpressionRef::from(&amp;expr),
        &amp;CommentRanges::default(),
        expression
    ));
}
