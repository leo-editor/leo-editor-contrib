<t tx="ekr.20231231171022.239">/// Visit an [`Expr`], and treat it as a runtime-evaluated type annotation.
fn visit_runtime_evaluated_annotation(&amp;mut self, expr: &amp;'a Expr) {
    let snapshot = self.semantic.flags;
    self.semantic.flags |= SemanticModelFlags::RUNTIME_EVALUATED_ANNOTATION;
    self.visit_type_definition(expr);
    self.semantic.flags = snapshot;
}
