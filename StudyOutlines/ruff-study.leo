<t tx="ekr.20231231171105.189">pub(super) fn new(
    source_code: SourceCode&lt;'a&gt;,
    comment_ranges: &amp;'a CommentRanges,
    builder: &amp;'builder mut (dyn PushComment&lt;'a&gt; + 'a),
) -&gt; Self {
    Self {
        builder,
        source_code,
        parents: Vec::new(),
        preceding_node: None,
        comment_ranges: comment_ranges.iter().peekable(),
    }
}
