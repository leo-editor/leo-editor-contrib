<t tx="ekr.20231231171104.702">fn fmt(&amp;self, f: &amp;mut Formatter&lt;'_&gt;) -&gt; std::fmt::Result {
    let mut list = f.debug_list();

    for comment in self.node_comments {
        list.entry(&amp;comment.debug(self.source_code));
    }

    list.finish()
}
