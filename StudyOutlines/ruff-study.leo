    @others
}
</t>
<t tx="ekr.20231231171059.156">pub(super) fn new(semantic: &amp;'a SemanticModel&lt;'b&gt;, logger_objects: &amp;'a [String]) -&gt; Self {
    LoggerCandidateVisitor {
        semantic,
        logger_objects,
        calls: Vec::new(),
    }
}
