<t tx="ekr.20231231171114.48">type Item = LexResult;

fn next(&amp;mut self) -&gt; Option&lt;Self::Item&gt; {
    let token = self.next_token();

    match token {
        Ok((Tok::EndOfFile, _)) =&gt; None,
        r =&gt; Some(r),
    }
}
