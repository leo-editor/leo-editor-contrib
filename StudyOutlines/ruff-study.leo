<t tx="ekr.20231231171024.296">const RULESET_SIZE: usize = 12;

/// A set of [`Rule`]s.
///
/// Uses a bitset where a bit of one signals that the Rule with that [u16] is in this set.
#[derive(Clone, Default, CacheKey, PartialEq, Eq)]
pub struct RuleSet([u64; RULESET_SIZE]);

impl RuleSet {
    @others
}
</t>
<t tx="ekr.20231231171024.297">impl Debug for RuleSet {
    @others
}
</t>
<t tx="ekr.20231231171024.298">impl FromIterator&lt;Rule&gt; for RuleSet {
    fn from_iter&lt;T: IntoIterator&lt;Item = Rule&gt;&gt;(iter: T) -&gt; Self {
        let mut set = RuleSet::empty();

        for rule in iter {
            set.insert(rule);
        }

        set
    }
}
</t>
<t tx="ekr.20231231171024.299">impl Extend&lt;Rule&gt; for RuleSet {
    fn extend&lt;T: IntoIterator&lt;Item = Rule&gt;&gt;(&amp;mut self, iter: T) {
        let set = std::mem::take(self);
        *self = set.union(&amp;RuleSet::from_iter(iter));
    }
}
