<t tx="ekr.20231231171021.163">pub fn new(source_code: SourceCode&lt;'a&gt;, options: PrinterOptions) -&gt; Self {
    Self {
        source_code,
        options,
        state: PrinterState::with_capacity(source_code.as_str().len()),
    }
}
