<t tx="ekr.20231231171103.204">pub struct Generator&lt;'a&gt; {
    /// The indentation style to use.
    indent: &amp;'a Indentation,
    /// The quote style to use for string literals.
    quote: Quote,
    /// The line ending to use.
    line_ending: LineEnding,
    buffer: String,
    indent_depth: usize,
    num_newlines: usize,
    initial: bool,
}
