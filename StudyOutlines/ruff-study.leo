<t tx="ekr.20231231171024.81">/// Return a truncated snippet for user-facing display.
pub(crate) fn truncated_display(&amp;self) -&gt; &amp;str {
    if Self::should_truncate(&amp;self.0) {
        "..."
    } else {
        &amp;self.0
    }
}
