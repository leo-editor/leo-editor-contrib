<t tx="ekr.20231231171024.22">type Item = SectionContext&lt;'a&gt;;

fn next(&amp;mut self) -&gt; Option&lt;Self::Item&gt; {
    let next = self.inner.next()?;

    Some(SectionContext {
        data: next,
