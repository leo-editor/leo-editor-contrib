<t tx="ekr.20231231171118.103">/// Return `true` if the [`Path`] is named `pyproject.toml`.
pub fn is_pyproject_toml(path: &amp;Path) -&gt; bool {
    path.file_name()
        .is_some_and(|name| name == "pyproject.toml")
}
</t>
<t tx="ekr.20231231171118.104">/// Return `true` if the [`Path`] appears to be that of a Python interface definition file (`.pyi`).
pub fn is_python_stub_file(path: &amp;Path) -&gt; bool {
    path.extension().is_some_and(|ext| ext == "pyi")
}
</t>
<t tx="ekr.20231231171118.105">/// Return `true` if the [`Path`] appears to be that of a Jupyter notebook (`.ipynb`).
pub fn is_jupyter_notebook(path: &amp;Path) -&gt; bool {
    path.extension().is_some_and(|ext| ext == "ipynb")
}
