                        if &amp;alias.name == "*" {
                            continue;
                        }
                        flake8_tidy_imports::rules::banned_module_level_imports(
                            checker,
                            &amp;flake8_tidy_imports::matchers::NameMatchPolicy::MatchName(
                                flake8_tidy_imports::matchers::MatchName {
                                    module: &amp;module,
                                    member: &amp;alias.name,
                                },
                            ),
                            &amp;alias,
