<t tx="ekr.20231231171026.41">/// S102
pub(crate) fn exec_used(checker: &amp;mut Checker, func: &amp;Expr) {
    if checker
        .semantic()
        .resolve_call_path(func)
        .is_some_and(|call_path| matches!(call_path.as_slice(), ["" | "builtin", "exec"]))
    {
        checker
            .diagnostics
            .push(Diagnostic::new(ExecBuiltin, func.range()));
    }
}
