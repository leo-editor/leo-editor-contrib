<t tx="ekr.20231231171102.129">fn visit_stmt(&amp;mut self, stmt: &amp;'b Stmt) {
    match stmt {
        Stmt::FunctionDef(_) | Stmt::ClassDef(_) =&gt; {
            // Don't recurse.
        }
        Stmt::Return(stmt) =&gt; self.returns.push(stmt),
        _ =&gt; crate::visitor::walk_stmt(self, stmt),
    }
}
</t>
