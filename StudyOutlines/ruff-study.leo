<t tx="ekr.20231231171115.126">pub fn start_marker(mode: Mode) -&gt; Self {
    match mode {
        Mode::Module | Mode::Ipython =&gt; Tok::StartModule,
        Mode::Expression =&gt; Tok::StartExpression,
    }
}
