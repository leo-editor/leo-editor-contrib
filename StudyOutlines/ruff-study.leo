<t tx="ekr.20231231171023.30">/// Run lint rules over a suite of [`Stmt`] syntax nodes.
pub(crate) fn suite(suite: &amp;[Stmt], checker: &amp;mut Checker) {
    if checker.enabled(Rule::UnnecessaryPlaceholder) {
        flake8_pie::rules::unnecessary_placeholder(checker, suite);
