<t tx="ekr.20231231171030.8">use ruff_python_ast::{Expr, Keyword};

pub(super) fn exactly_one_argument_with_matching_function&lt;'a&gt;(
    name: &amp;str,
    func: &amp;Expr,
    args: &amp;'a [Expr],
    keywords: &amp;[Keyword],
) -&gt; Option&lt;&amp;'a Expr&gt; {
    let [arg] = args else {
        return None;
    };
    if !keywords.is_empty() {
        return None;
    }
    let func = func.as_name_expr()?;
    if func.id != name {
        return None;
    }
    Some(arg)
}

pub(super) fn first_argument_with_matching_function&lt;'a&gt;(
    name: &amp;str,
    func: &amp;Expr,
    args: &amp;'a [Expr],
) -&gt; Option&lt;&amp;'a Expr&gt; {
    if func.as_name_expr().is_some_and(|func| func.id == name) {
        args.first()
    } else {
        None
    }
}
