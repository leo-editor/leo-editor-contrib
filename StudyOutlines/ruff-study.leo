<t tx="ekr.20231231171112.88">/// Whether this is the last line in the docstring or not.
fn is_last(&amp;self) -&gt; bool {
    self.next.is_none()
}
</t>
<t tx="ekr.20231231171112.89">/// Return this reformatted line, but with the given function applied to
/// the text of the line.
fn map(self, mut map: impl FnMut(&amp;str) -&gt; String) -&gt; OutputDocstringLine&lt;'static&gt; {
    OutputDocstringLine {
        line: Cow::Owned(map(&amp;self.line)),
        ..self
    }
}
