<t tx="ekr.20231231171115.150">/// Consumes the next character
pub(super) fn bump(&amp;mut self) -&gt; Option&lt;char&gt; {
    let prev = self.chars.next()?;

    #[cfg(debug_assertions)]
    {
        self.prev_char = prev;
    }

    Some(prev)
}
