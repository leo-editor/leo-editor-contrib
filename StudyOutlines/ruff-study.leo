<t tx="ekr.20231231171120.53">/// A range in text, represented as a pair of [`TextSize`][struct@TextSize].
///
/// It is a logic error for `start` to be greater than `end`.
#[derive(Default, Copy, Clone, Eq, PartialEq, Hash)]
pub struct TextRange {
    // Invariant: start &lt;= end
    start: TextSize,
    end: TextSize,
}
</t>
