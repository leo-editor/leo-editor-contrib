<t tx="ekr.20231231171102.1719">pub fn as_str(&amp;self) -&gt; &amp;'static str {
    match self {
        CmpOp::Eq =&gt; "==",
        CmpOp::NotEq =&gt; "!=",
        CmpOp::Lt =&gt; "&lt;",
        CmpOp::LtE =&gt; "&lt;=",
        CmpOp::Gt =&gt; "&gt;",
        CmpOp::GtE =&gt; "&gt;=",
        CmpOp::Is =&gt; "is",
        CmpOp::IsNot =&gt; "is not",
        CmpOp::In =&gt; "in",
        CmpOp::NotIn =&gt; "not in",
    }
}
