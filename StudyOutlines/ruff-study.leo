<t tx="ekr.20231231171102.188">/// Creates a new `ImportFrom` to import a member from the specified module.
pub fn member(module: &amp;'a str, name: &amp;'a str) -&gt; Self {
    Self {
        module: Some(module),
        name: Alias {
            name,
            as_name: None,
        },
        level: None,
    }
}
