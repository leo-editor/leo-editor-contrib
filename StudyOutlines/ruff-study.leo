<t tx="ekr.20231231171113.70">#[derive(Debug, PartialEq, Eq, Copy, Clone, Hash, is_macro::Is)]
pub enum Quote {
    Single,
    Double,
}

impl Quote {
    #[inline]
    #[must_use]
    pub const fn swap(self) -&gt; Self {
        match self {
            Quote::Single =&gt; Quote::Double,
            Quote::Double =&gt; Quote::Single,
        }
    }

    #[inline]
    pub const fn to_byte(&amp;self) -&gt; u8 {
        match self {
            Quote::Single =&gt; b'\'',
            Quote::Double =&gt; b'"',
        }
    }

    #[inline]
    pub const fn to_char(&amp;self) -&gt; char {
        match self {
            Quote::Single =&gt; '\'',
            Quote::Double =&gt; '"',
        }
    }
}
</t>
