<t tx="ekr.20231231171102.190">fn fmt(&amp;self, f: &amp;mut std::fmt::Formatter) -&gt; std::fmt::Result {
    write!(f, "import {}", self.name.name)?;
    if let Some(as_name) = self.name.as_name {
        write!(f, " as {as_name}")?;
    }
    Ok(())
}
</t>
<t tx="ekr.20231231171102.191">fn fmt(&amp;self, f: &amp;mut std::fmt::Formatter) -&gt; std::fmt::Result {
    write!(f, "from ")?;
    if let Some(level) = self.level {
        write!(f, "{}", ".".repeat(level as usize))?;
    }
    if let Some(module) = self.module {
        write!(f, "{module}")?;
    }
    write!(f, " import {}", self.name.name)?;
    if let Some(as_name) = self.name.as_name {
        write!(f, " as {as_name}")?;
    }
    Ok(())
}
</t>
