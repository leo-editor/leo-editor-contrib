<t tx="ekr.20231231171020.65">fn cmp(&amp;self, other: &amp;Self) -&gt; Ordering {
    self.start()
        .cmp(&amp;other.start())
        .then_with(|| self.end().cmp(&amp;other.end()))
        .then_with(|| self.content.cmp(&amp;other.content))
}
</t>
<t tx="ekr.20231231171020.66">fn partial_cmp(&amp;self, other: &amp;Self) -&gt; Option&lt;Ordering&gt; {
    Some(self.cmp(other))
}
</t>
