    @others
}
</t>
<t tx="ekr.20231231171053.110">fn num_statements(stmts: &amp;[Stmt]) -&gt; usize {
    let mut count = 0;
    for stmt in stmts {
        match stmt {
            Stmt::If(ast::StmtIf {
                body,
                elif_else_clauses,
                ..
            }) =&gt; {
                count += 1;
                count += num_statements(body);
                for clause in elif_else_clauses {
                    count += 1;
                    count += num_statements(&amp;clause.body);
                }
            }
            Stmt::For(ast::StmtFor { body, orelse, .. }) =&gt; {
                count += num_statements(body);
                count += num_statements(orelse);
            }
            Stmt::While(ast::StmtWhile { body, orelse, .. }) =&gt; {
                count += 1;
                count += num_statements(body);
                count += num_statements(orelse);
            }
            Stmt::Match(ast::StmtMatch { cases, .. }) =&gt; {
                count += 1;
                for case in cases {
                    count += num_statements(&amp;case.body);
                }
            }
            Stmt::Try(ast::StmtTry {
                body,
                handlers,
                orelse,
                finalbody,
                ..
            }) =&gt; {
                count += 1;
                count += num_statements(body);
                if !orelse.is_empty() {
                    count += 1 + num_statements(orelse);
                }
                if !finalbody.is_empty() {
                    // Unclear why, but follow Pylint's convention.
                    count += 2 + num_statements(finalbody);
                }
                if handlers.len() &gt; 1 {
                    count += 1;
                }
                for handler in handlers {
                    count += 1;
                    let ExceptHandler::ExceptHandler(ast::ExceptHandlerExceptHandler {
                        body, ..
                    }) = handler;
                    count += num_statements(body);
                }
            }
            Stmt::FunctionDef(ast::StmtFunctionDef { body, .. })
            | Stmt::With(ast::StmtWith { body, .. }) =&gt; {
                count += 1;
                count += num_statements(body);
            }
            Stmt::Return(_) =&gt; {}
            _ =&gt; {
                count += 1;
            }
        }
    }
    count
}
</t>
<t tx="ekr.20231231171053.111">/// PLR0915
pub(crate) fn too_many_statements(
    stmt: &amp;Stmt,
    body: &amp;[Stmt],
    max_statements: usize,
) -&gt; Option&lt;Diagnostic&gt; {
    let statements = num_statements(body);
    if statements &gt; max_statements {
        Some(Diagnostic::new(
            TooManyStatements {
                statements,
                max_statements,
            },
            stmt.identifier(),
        ))
    } else {
        None
    }
}
</t>
