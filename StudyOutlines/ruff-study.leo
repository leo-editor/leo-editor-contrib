<t tx="ekr.20231231171037.13">fn fmt(&amp;self, f: &amp;mut Formatter&lt;'_&gt;) -&gt; std::fmt::Result {
    match self {
        Self::Tuple =&gt; write!(f, "tuple"),
        Self::List =&gt; write!(f, "list"),
    }
