<t tx="ekr.20231231171114.8">/// Create a new lexer from a source string, starting at a given location.
/// You probably want to use [`lex`] instead.
pub fn lex_starts_at(
    source: &amp;str,
    mode: Mode,
    start_offset: TextSize,
) -&gt; LexStartsAtIterator&lt;SoftKeywordTransformer&lt;Lexer&gt;&gt; {
    LexStartsAtIterator {
        start_offset,
        inner: lex(source, mode),
    }
}
</t>
