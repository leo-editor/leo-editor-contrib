<t tx="ekr.20231231171113.110">fn escaped_char_len(ch: u8) -&gt; usize {
    match ch {
        b'\\' | b'\t' | b'\r' | b'\n' =&gt; 2,
        0x20..=0x7e =&gt; 1,
        _ =&gt; 4, // \xHH
    }
}
</t>
<t tx="ekr.20231231171113.111">fn write_char(ch: u8, quote: Quote, formatter: &amp;mut impl std::fmt::Write) -&gt; std::fmt::Result {
    match ch {
        b'\t' =&gt; formatter.write_str("\\t"),
        b'\n' =&gt; formatter.write_str("\\n"),
        b'\r' =&gt; formatter.write_str("\\r"),
        0x20..=0x7e =&gt; {
            // printable ascii range
            if ch == quote.to_byte() || ch == b'\\' {
                formatter.write_char('\\')?;
            }
            formatter.write_char(ch as char)
        }
        ch =&gt; write!(formatter, "\\x{ch:02x}"),
    }
}
</t>
