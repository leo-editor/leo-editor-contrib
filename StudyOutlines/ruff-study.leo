<t tx="ekr.20231231171105.263">/// Returns the index of the operand's right operator. The method always returns an index
/// even if the operand has no right operator. Use [`BinaryCallChain::get_operator`] to test if
/// the operand has a right operator.
fn right_operator(self) -&gt; OperatorIndex {
    OperatorIndex::new(self.0 + 1)
}
