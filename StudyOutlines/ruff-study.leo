<t tx="ekr.20231231171114.52">fn fmt(&amp;self, f: &amp;mut std::fmt::Formatter) -&gt; std::fmt::Result {
    write!(
        f,
        "{} at byte offset {}",
        &amp;self.error,
        u32::from(self.location)
