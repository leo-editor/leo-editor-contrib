<t tx="ekr.20231231171023.19">/// Run lint rules over a module.
pub(crate) fn module(suite: &amp;Suite, checker: &amp;mut Checker) {
    if checker.enabled(Rule::FStringDocstring) {
        flake8_bugbear::rules::f_string_docstring(checker, suite);
    }
}
