<t tx="ekr.20231231171022.24">/// A directive to ignore a set of rules for a given line of Python source code (e.g.,
/// `# noqa: F401, F841`).
#[derive(Debug)]
pub(crate) enum Directive&lt;'a&gt; {
    /// The `noqa` directive ignores all rules (e.g., `# noqa`).
    All(All),
    /// The `noqa` directive ignores specific rules (e.g., `# noqa: F401, F841`).
    Codes(Codes&lt;'a&gt;),
}

impl&lt;'a&gt; Directive&lt;'a&gt; {
    @others
}
