<t tx="ekr.20231231171042.106">/// Lowercase the given string, if it contains any uppercase characters.
fn maybe_lowercase(name: &amp;str) -&gt; Cow&lt;'_, str&gt; {
    if name.chars().all(char::is_lowercase) {
        Cow::Borrowed(name)
    } else {
        Cow::Owned(name.to_lowercase())
    }
}
