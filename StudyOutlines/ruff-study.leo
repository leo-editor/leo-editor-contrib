<t tx="ekr.20231231171018.185">fn resolve_bool_arg(yes: bool, no: bool) -&gt; Option&lt;bool&gt; {
    match (yes, no) {
        (true, false) =&gt; Some(true),
        (false, true) =&gt; Some(false),
        (false, false) =&gt; None,
        (..) =&gt; unreachable!("Clap should make this impossible"),
    }
}
