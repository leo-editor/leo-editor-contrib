<t tx="ekr.20231231171119.240">fn cmp(&amp;self, other: &amp;Self) -&gt; Ordering {
    // Short circuit if these are the same source files
    if Arc::ptr_eq(&amp;self.inner, &amp;other.inner) {
        Ordering::Equal
    } else {
        self.inner.name.cmp(&amp;other.inner.name)
    }
}
