<t tx="ekr.20231231171114.159">type Err = ModeParseError;
fn from_str(s: &amp;str) -&gt; Result&lt;Self, ModeParseError&gt; {
    match s {
        "exec" | "single" =&gt; Ok(Mode::Module),
        "eval" =&gt; Ok(Mode::Expression),
        "ipython" =&gt; Ok(Mode::Ipython),
        _ =&gt; Err(ModeParseError),
    }
}
