<t tx="ekr.20231231171121.121">pub fn try_into_settings(self) -&gt; anyhow::Result&lt;flake8_copyright::settings::Settings&gt; {
    Ok(flake8_copyright::settings::Settings {
        notice_rgx: self
            .notice_rgx
            .map(|pattern| Regex::new(&amp;pattern))
            .transpose()?
            .unwrap_or_else(|| flake8_copyright::settings::COPYRIGHT.clone()),
        author: self.author,
