        Stmt::Expr(x) =&gt; x.format().fmt(f),
        Stmt::Pass(x) =&gt; x.format().fmt(f),
        Stmt::Break(x) =&gt; x.format().fmt(f),
        Stmt::Continue(x) =&gt; x.format().fmt(f),
