<t tx="ekr.20231231171113.115">#[cold]
fn write_body_slow(&amp;self, formatter: &amp;mut impl std::fmt::Write) -&gt; std::fmt::Result {
    for ch in self.source {
        Self::write_char(*ch, self.layout().quote, formatter)?;
    }
    Ok(())
}
