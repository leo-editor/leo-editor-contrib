<t tx="ekr.20231231171100.59">fn visit_stmt(&amp;mut self, stmt: &amp;'b Stmt) {
    match stmt {
        Stmt::Raise(raise @ ast::StmtRaise { .. }) =&gt; {
            self.raises.push(raise);
        }
        Stmt::Try(ast::StmtTry {
            body, finalbody, ..
        }) =&gt; {
            for stmt in body.iter().chain(finalbody.iter()) {
                walk_stmt(self, stmt);
            }
        }
        _ =&gt; walk_stmt(self, stmt),
    }
}
</t>
