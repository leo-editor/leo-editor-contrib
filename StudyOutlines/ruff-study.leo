<t tx="ekr.20231231171055.11">/// Create a list of field assignments from the `NamedTuple` keyword arguments.
fn create_fields_from_keywords(keywords: &amp;[Keyword]) -&gt; Option&lt;Vec&lt;Stmt&gt;&gt; {
    keywords
        .iter()
        .map(|keyword| {
            keyword
                .arg
                .as_ref()
                .map(|field| create_field_assignment_stmt(field.as_str(), &amp;keyword.value))
