<t tx="ekr.20231231171018.96">fn cache_key(&amp;self, state: &amp;mut CacheKeyHasher);

fn cache_key_slice(data: &amp;[Self], state: &amp;mut CacheKeyHasher)
where
    Self: Sized,
{
    for piece in data {
        piece.cache_key(state);
    }
}
