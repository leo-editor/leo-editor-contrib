        (Pyflakes, "901") =&gt; (RuleGroup::Stable, rules::pyflakes::rules::RaiseNotImplemented),

        // pylint
        (Pylint, "C0105") =&gt; (RuleGroup::Stable, rules::pylint::rules::TypeNameIncorrectVariance),
