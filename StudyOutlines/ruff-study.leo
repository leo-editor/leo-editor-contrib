<t tx="ekr.20231231171119.190">fn visit_body(&amp;mut self, body: &amp;[Stmt]) {
    if let (Some(first), Some(last)) = (body.first(), body.last()) {
        if !(first == last &amp;&amp; matches!(first, Stmt::Pass(_))) {
            self.ranges.push(TextRange::new(first.start(), last.end()));
        }
    }
    walk_body(self, body);
}
</t>
<t tx="ekr.20231231171119.191">fn visit_stmt(&amp;mut self, stmt: &amp;Stmt) {
    if !matches!(stmt, Stmt::Pass(_)) {
        self.ranges.push(stmt.range());
    }
    walk_stmt(self, stmt);
}
