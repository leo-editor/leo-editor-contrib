<t tx="ekr.20231231171049.56">pub(crate) fn return_outside_function(checker: &amp;mut Checker, stmt: &amp;Stmt) {
    if matches!(
        checker.semantic().current_scope().kind,
        ScopeKind::Class(_) | ScopeKind::Module
    ) {
        checker
            .diagnostics
            .push(Diagnostic::new(ReturnOutsideFunction, stmt.range()));
    }
}
