<t tx="ekr.20231231171048.182">#[test]
fn nested_class() {
    // Nested classes can access enclosing scope.
    flakes(
        r"
    def f(foo):
        class C:
            bar = foo
            def f(self):
                return foo
        return C()

    f(123).f()
    ",
        &amp;[],
    );
}
</t>
<t tx="ekr.20231231171048.183">#[test]
fn bad_nested_class() {
