<t tx="ekr.20231231171022.179">impl Linter {
    pub const fn upstream_categories(&amp;self) -&gt; Option&lt;&amp;'static [UpstreamCategoryAndPrefix]&gt; {
        match self {
            Linter::Pycodestyle =&gt; Some(&amp;[E, W]),
            Linter::Pylint =&gt; Some(&amp;[PLC, PLE, PLR, PLW]),
            _ =&gt; None,
        }
    }
}
</t>
<t tx="ekr.20231231171022.18">fn fmt(&amp;self, f: &amp;mut Formatter&lt;'_&gt;) -&gt; std::fmt::Result {
    @others
    write!(
        TruncateAdapter {
            inner: f,
            after_new_line: false,
        },
        "{}",
        self.0
    )
}
</t>
<t tx="ekr.20231231171022.180">pub fn upstream_category(&amp;self, linter: &amp;Linter) -&gt; Option&lt;UpstreamCategoryAndPrefix&gt; {
    let code = linter.code_for_rule(*self).unwrap();
    match linter {
        Linter::Pycodestyle =&gt; {
            if code.starts_with('E') {
                Some(E)
            } else if code.starts_with('W') {
                Some(W)
            } else {
                None
            }
        }
        Linter::Pylint =&gt; {
            if code.starts_with("PLC") {
                Some(PLC)
            } else if code.starts_with("PLE") {
                Some(PLE)
            } else if code.starts_with("PLR") {
                Some(PLR)
            } else if code.starts_with("PLW") {
                Some(PLW)
            } else {
                None
            }
        }
        _ =&gt; None,
    }
}
</t>
