<t tx="ekr.20231231171109.47">fn is_pattern_parenthesized(
    pattern: &amp;Pattern,
    comment_ranges: &amp;CommentRanges,
    contents: &amp;str,
) -&gt; bool {
    // First test if there's a closing parentheses because it tends to be cheaper.
    if matches!(
        first_non_trivia_token(pattern.end(), contents),
        Some(SimpleToken {
            kind: SimpleTokenKind::RParen,
            ..
        })
    ) {
        matches!(
            BackwardsTokenizer::up_to(pattern.start(), contents, comment_ranges)
                .skip_trivia()
                .next(),
            Some(SimpleToken {
                kind: SimpleTokenKind::LParen,
                ..
            })
        )
    } else {
        false
    }
}
</t>
<t tx="ekr.20231231171109.48">impl NeedsParentheses for Pattern {
