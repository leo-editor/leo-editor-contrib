<t tx="ekr.20231231171024.80">/// Return the full snippet for user-facing display, or `None` if the snippet should be
/// truncated.
pub(crate) fn full_display(&amp;self) -&gt; Option&lt;&amp;str&gt; {
    if Self::should_truncate(&amp;self.0) {
        None
    } else {
        Some(&amp;self.0)
    }
}
