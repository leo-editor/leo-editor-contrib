<t tx="ekr.20231231171108.76">fn fmt_fields(&amp;self, item: &amp;Keyword, f: &amp;mut PyFormatter) -&gt; FormatResult&lt;()&gt; {
    let Keyword {
        range: _,
        arg,
        value,
    } = item;
    // Comments after the `=` or `**` are reassigned as leading comments on the value.
    if let Some(arg) = arg {
        write!(f, [arg.format(), token("="), value.format()])
    } else {
        write!(f, [token("**"), value.format()])
    }
}
