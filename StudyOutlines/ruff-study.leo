<t tx="ekr.20231231171048.186">#[test]
fn used_as_star_unpack() {
    // In stable, starred names in unpack are used if RHS is not a tuple/list literal.
    // In preview, these should be marked as unused.
    flakes(
        r"
    def f():
        a, *b = range(10)
    ",
        &amp;[],
