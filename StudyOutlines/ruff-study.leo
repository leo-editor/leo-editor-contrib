<t tx="ekr.20231231171023.74">pub(crate) fn triple_quoted(&amp;self) -&gt; bool {
    let leading_quote = self.leading_quote();
    leading_quote.ends_with("\"\"\"") || leading_quote.ends_with("'''")
}
</t>
<t tx="ekr.20231231171023.75">fn range(&amp;self) -&gt; TextRange {
    self.expr.range()
}
