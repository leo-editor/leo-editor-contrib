<t tx="ekr.20231231171048.265">#[test]
fn used_in_global() {
    // A 'global' statement shadowing an unused import should not prevent it
    // from being reported.
    flakes(
        r"
    import fu
    def f(): global fu
    ",
        &amp;[Rule::UnusedImport],
    );
}
</t>
<t tx="ekr.20231231171048.266">#[test]
fn used_and_global() {
    // A 'global' statement shadowing a used import should not cause it to be
    // reported as unused.
    flakes(
        r"
        import foo
        def f(): global foo
        def g(): foo.is_used()
    ",
        &amp;[],
    );
}
</t>
<t tx="ekr.20231231171048.267">#[test]
fn assigned_to_global() {
