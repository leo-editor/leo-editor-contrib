<t tx="ekr.20231231171102.120">/// Return `true` if a `Stmt` is a docstring.
pub fn is_docstring_stmt(stmt: &amp;Stmt) -&gt; bool {
    if let Stmt::Expr(ast::StmtExpr { value, range: _ }) = stmt {
        value.is_string_literal_expr()
    } else {
        false
    }
}
</t>
