<t tx="ekr.20231231171117.38">/// Extracts the set of global names from a given scope, or return `None` if the scope does not
/// contain any `global` declarations.
pub fn from_body(body: &amp;'a [Stmt]) -&gt; Option&lt;Self&gt; {
    let mut builder = GlobalsVisitor::new();
    builder.visit_body(body);
    builder.finish()
}
