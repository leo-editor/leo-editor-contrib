<t tx="ekr.20231231171103.145">fn emit(&amp;mut self, text: &amp;dyn Debug) {
    for _ in 0..self.depth {
        self.output.push_str("  ");
    }

    writeln!(self.output, "- {text:?}").unwrap();
}
</t>
<t tx="ekr.20231231171103.146">fn enter_node(&amp;mut self, node: AnyNodeRef&lt;'a&gt;) -&gt; TraversalSignal {
    self.emit(&amp;node.kind());
    self.depth += 1;

    TraversalSignal::Traverse
}
</t>
<t tx="ekr.20231231171103.147">fn leave_node(&amp;mut self, _node: AnyNodeRef&lt;'a&gt;) {
    self.depth -= 1;
}
</t>
