#[derive(Copy, Clone, Debug)]
pub(super) enum BinaryLike&lt;'a&gt; {
    Binary(&amp;'a ExprBinOp),
    Compare(&amp;'a ExprCompare),
    Bool(&amp;'a ExprBoolOp),
}

