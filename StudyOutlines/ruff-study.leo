fn indent_nonempty() {
    let text = [
        "  foo\n",
        "bar\n",
        "  baz\n",
    ].join("");
    let expected = [
        "//   foo\n",
        "// bar\n",
        "//   baz\n",
    ].join("");
    assert_eq!(indent(&amp;text, "// "), expected);
}
