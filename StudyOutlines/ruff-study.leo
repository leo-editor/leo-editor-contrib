<t tx="ekr.20231231171121.166">fn fmt(&amp;self, f: &amp;mut Formatter&lt;'_&gt;) -&gt; std::fmt::Result {
    let mut visitor = DisplayVisitor::new(f);
    self.record(&amp;mut visitor);
