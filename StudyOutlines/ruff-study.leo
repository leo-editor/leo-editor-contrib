<t tx="ekr.20231231171119.41">pub const EOF_CHAR: char = '\0';

/// A [`Cursor`] over a string.
#[derive(Debug, Clone)]
pub struct Cursor&lt;'a&gt; {
    chars: Chars&lt;'a&gt;,
    source_length: TextSize,
}
