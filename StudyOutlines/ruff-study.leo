            },
            ..LinterSettings::for_rules(vec![
                Rule::MissingTypeFunctionArgument,
                Rule::MissingTypeArgs,
                Rule::MissingTypeKwargs,
                Rule::MissingTypeSelf,
                Rule::MissingTypeCls,
            ])
        },
    )?;
    assert_messages!(diagnostics);
    Ok(())
}
