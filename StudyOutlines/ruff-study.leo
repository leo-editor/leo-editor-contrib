    walk_annotation(self, expr);
}
</t>
<t tx="ekr.20231231171103.87">fn visit_decorator(&amp;self, decorator: &amp;mut Decorator) {
    walk_decorator(self, decorator);
}
</t>
<t tx="ekr.20231231171103.88">fn visit_expr(&amp;self, expr: &amp;mut Expr) {
    walk_expr(self, expr);
}
</t>
<t tx="ekr.20231231171103.89">fn visit_expr_context(&amp;self, expr_context: &amp;mut ExprContext) {
    walk_expr_context(self, expr_context);
}
