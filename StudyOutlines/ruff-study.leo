<t tx="ekr.20231231171104.62">pub(crate) fn new(level: IndentLevel, mut buffer: D) -&gt; Self {
    let context = buffer.state_mut().context_mut();
    let saved_level = context.indent_level();

    context.set_indent_level(level);

    Self {
        buffer,
        saved_level,
    }
}
