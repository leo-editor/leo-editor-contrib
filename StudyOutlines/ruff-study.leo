<t tx="ekr.20231231171105.12">/// Helper that inserts the appropriate number of empty lines before a comment, depending on the node level:
/// - Top-level: Up to two empty lines.
/// - Parenthesized: A single empty line.
/// - Otherwise: Up to a single empty line.
pub(crate) const fn empty_lines(lines: u32) -&gt; FormatEmptyLines {
    FormatEmptyLines { lines }
}

