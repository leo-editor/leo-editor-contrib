<t tx="ekr.20231231171106.12">fn fmt(&amp;self, item: &amp;CmpOp, f: &amp;mut PyFormatter) -&gt; FormatResult&lt;()&gt; {
    let operator = match item {
        CmpOp::Eq =&gt; "==",
        CmpOp::NotEq =&gt; "!=",
        CmpOp::Lt =&gt; "&lt;",
        CmpOp::LtE =&gt; "&lt;=",
        CmpOp::Gt =&gt; "&gt;",
        CmpOp::GtE =&gt; "&gt;=",
        CmpOp::Is =&gt; "is",
        CmpOp::IsNot =&gt; "is not",
        CmpOp::In =&gt; "in",
        CmpOp::NotIn =&gt; "not in",
    };

    token(operator).fmt(f)
}
