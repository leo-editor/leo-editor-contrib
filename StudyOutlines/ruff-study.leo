<t tx="ekr.20231231171102.1706">/// Returns the [`ParameterWithDefault`] with the given name, or `None` if no such [`ParameterWithDefault`] exists.
pub fn find(&amp;self, name: &amp;str) -&gt; Option&lt;&amp;ParameterWithDefault&gt; {
    self.posonlyargs
        .iter()
        .chain(&amp;self.args)
        .chain(&amp;self.kwonlyargs)
        .find(|arg| arg.parameter.name.as_str() == name)
}
</t>
<t tx="ekr.20231231171102.1707">/// Returns `true` if a parameter with the given name included in this [`Parameters`].
pub fn includes(&amp;self, name: &amp;str) -&gt; bool {
    if self
        .posonlyargs
        .iter()
        .chain(&amp;self.args)
        .chain(&amp;self.kwonlyargs)
        .any(|arg| arg.parameter.name.as_str() == name)
    {
        return true;
    }
    if let Some(arg) = &amp;self.vararg {
        if arg.name.as_str() == name {
            return true;
        }
    }
    if let Some(arg) = &amp;self.kwarg {
        if arg.name.as_str() == name {
            return true;
        }
    }
    false
}
</t>
<t tx="ekr.20231231171102.1708">/// Returns `true` if the [`Parameters`] is empty.
pub fn is_empty(&amp;self) -&gt; bool {
    self.posonlyargs.is_empty()
        &amp;&amp; self.args.is_empty()
        &amp;&amp; self.kwonlyargs.is_empty()
        &amp;&amp; self.vararg.is_none()
        &amp;&amp; self.kwarg.is_none()
}
</t>
