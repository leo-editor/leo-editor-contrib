<t tx="ekr.20231231171050.104">type Error = ();

fn try_from(value: char) -&gt; Result&lt;Self, Self::Error&gt; {
    match value {
        'r' =&gt; Ok(Self::READ),
        'w' =&gt; Ok(Self::WRITE),
        'a' =&gt; Ok(Self::APPEND),
        'x' =&gt; Ok(Self::CREATE),
        'b' =&gt; Ok(Self::BINARY),
        't' =&gt; Ok(Self::TEXT),
        '+' =&gt; Ok(Self::PLUS),
        'U' =&gt; Ok(Self::UNIVERSAL_NEWLINES),
        _ =&gt; Err(()),
    }
}
