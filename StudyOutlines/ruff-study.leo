<t tx="ekr.20231231171037.214">fn new(
    check_for_escaped_quote: bool,
    fstring_start_range: TextRange,
    quote_style: Quote,
) -&gt; Self {
    Self {
        check_for_escaped_quote,
        start_range: fstring_start_range,
        middle_ranges_with_escapes: vec![],
        quote_style,
    }
}
