                ..super::settings::Settings::default()
            },
            src: vec![test_resource_path("fixtures/isort")],
            ..LinterSettings::for_rule(Rule::UnsortedImports)
        },
    )?;
    assert_messages!(snapshot, diagnostics);
    Ok(())
}
