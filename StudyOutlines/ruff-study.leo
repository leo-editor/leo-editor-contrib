<t tx="ekr.20231231171022.240">/// Visit an [`Expr`], and treat it as a runtime-required type annotation.
fn visit_runtime_required_annotation(&amp;mut self, expr: &amp;'a Expr) {
    let snapshot = self.semantic.flags;
    self.semantic.flags |= SemanticModelFlags::RUNTIME_REQUIRED_ANNOTATION;
    self.visit_type_definition(expr);
    self.semantic.flags = snapshot;
}
