                    if let Some(asname) = &amp;alias.asname {
                        if let Some(diagnostic) =
                            flake8_import_conventions::rules::banned_import_alias(
                                stmt,
                                &amp;alias.name,
                                asname,
                                &amp;checker.settings.flake8_import_conventions.banned_aliases,
                            )
                        {
                            checker.diagnostics.push(diagnostic);
                        }
                    }
