<t tx="ekr.20231231171114.27">/// Create a new lexer from T and a starting location. You probably want to use
/// [`lex`] instead.
pub fn new(input: &amp;'source str, mode: Mode) -&gt; Self {
    assert!(
        u32::try_from(input.len()).is_ok(),
        "Lexer only supports files with a size up to 4GB"
    );

    let mut lxr = Lexer {
        state: State::AfterNewline,
        nesting: 0,
        indentations: Indentations::default(),
        pending_indentation: None,

        source: input,
        cursor: Cursor::new(input),
        mode,
        fstrings: FStrings::default(),
    };
    // TODO: Handle possible mismatch between BOM and explicit encoding declaration.
    // spell-checker:ignore feff
    lxr.cursor.eat_char('\u{feff}');

    lxr
}
</t>
