<t tx="ekr.20231231171102.1828">/// Change an expression's location (recursively) to match a desired, fixed
/// range.
pub fn relocate_expr(expr: &amp;mut Expr, range: TextRange) {
    Relocator { range }.visit_expr(expr);
}
</t>
