<t tx="ekr.20231231171102.124">/// Format the expression as a PEP 604-style optional.
pub fn pep_604_optional(expr: &amp;Expr) -&gt; Expr {
    ast::ExprBinOp {
        left: Box::new(expr.clone()),
        op: Operator::BitOr,
        right: Box::new(Expr::NoneLiteral(ast::ExprNoneLiteral::default())),
        range: TextRange::default(),
    }
    .into()
}
