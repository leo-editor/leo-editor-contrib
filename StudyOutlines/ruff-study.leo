fn test_from_rule_selectors_specificity() {
    use Applicability::{Safe, Unsafe};
    let table = mk_table(&amp;["UP"], &amp;["ALL", "UP001"]);

    assert_rules_safety(
        &amp;table,
        &amp;[
            ("E101", Safe, Unsafe),
            ("UP001", Safe, Unsafe),
            ("UP003", Unsafe, Safe),
        ],
    );
}
