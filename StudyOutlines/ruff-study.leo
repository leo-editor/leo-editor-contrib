<t tx="ekr.20231231171102.551">fn cast(kind: AnyNode) -&gt; Option&lt;Self&gt;
where
    Self: Sized,
{
    if let AnyNode::ModModule(node) = kind {
        Some(node)
    } else {
        None
    }
}
</t>
