<t tx="ekr.20231231171121.165">fn record_field(&amp;mut self, name: &amp;str, field: OptionField) {
    self.result = self.result.and_then(|()| {
        write!(self.f, "{name}")?;

        if field.deprecated.is_some() {
            write!(self.f, " (deprecated)")?;
        }

        writeln!(self.f)
    });
}
