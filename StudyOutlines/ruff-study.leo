<t tx="ekr.20231231171023.39">/// Parse a shebang directive from a line, or return `None` if the line does not contain a
/// shebang directive.
pub(crate) fn try_extract(line: &amp;'a str) -&gt; Option&lt;Self&gt; {
    let mut cursor = Cursor::new(line);

    // Trim the `#!` prefix.
    if !cursor.eat_char('#') {
        return None;
    }
    if !cursor.eat_char('!') {
        return None;
    }

    Some(Self(cursor.chars().as_str()))
}
</t>
