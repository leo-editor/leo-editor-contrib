    let SingleItemMembershipTest { membership_test } = self;
    match membership_test {
        MembershipTest::In =&gt; Some("Convert to equality test".to_string()),
        MembershipTest::NotIn =&gt; Some("Convert to inequality test".to_string()),
    }
}
