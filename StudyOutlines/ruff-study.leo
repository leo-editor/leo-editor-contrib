<t tx="ekr.20231231171051.58">/// PLW0604
pub(crate) fn global_at_module_level(checker: &amp;mut Checker, stmt: &amp;Stmt) {
    if checker.semantic().current_scope().kind.is_module() {
        checker
            .diagnostics
            .push(Diagnostic::new(GlobalAtModuleLevel, stmt.range()));
    }
}
