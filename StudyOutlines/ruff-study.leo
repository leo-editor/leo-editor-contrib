<t tx="ekr.20231231171105.26">fn fmt(&amp;self, f: &amp;mut Formatter&lt;PyFormatContext&gt;) -&gt; FormatResult&lt;()&gt; {
    match self.comment {
        Cow::Borrowed(borrowed) =&gt; {
            source_text_slice(TextRange::at(self.range.start(), borrowed.text_len())).fmt(f)
        }

        Cow::Owned(ref owned) =&gt; {
            write!(
                f,
                [
                    text(owned, Some(self.range.start())),
                    source_position(self.range.end())
                ]
            )
        }
    }
}
</t>
<t tx="ekr.20231231171105.260">fn fmt(&amp;self, f: &amp;mut Formatter&lt;PyFormatContext&lt;'_&gt;&gt;) -&gt; FormatResult&lt;()&gt; {
    match self {
        OperatorSymbol::Binary(operator) =&gt; operator.format().fmt(f),
        OperatorSymbol::Comparator(operator) =&gt; operator.format().fmt(f),
        OperatorSymbol::Bool(bool) =&gt; bool.format().fmt(f),
    }
}
