<t tx="ekr.20231231171027.29">/// Return the [`Safety`] level for the [`Expr`]. This is based on Bandit's definition: string
/// literals are considered okay, but dynamically-computed values are not.
fn from(expr: &amp;Expr) -&gt; Self {
    if expr.is_string_literal_expr() {
        Self::SeemsSafe
    } else {
        Self::Unknown
    }
}
