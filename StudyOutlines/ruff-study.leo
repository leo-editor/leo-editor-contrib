<t tx="ekr.20231231171021.301">/// Represents a newtype wrapper used to index into a Vec or a slice.
///
/// You can use the [`newtype_index`](crate::newtype_index) macro to define your own index.
pub trait Idx: Copy + PartialEq + Eq + Hash + std::fmt::Debug + 'static {
    fn new(value: usize) -&gt; Self;

    fn index(self) -&gt; usize;
}
</t>
