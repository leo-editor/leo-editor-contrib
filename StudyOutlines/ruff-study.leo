<t tx="ekr.20231231171022.60">fn find_line_index(&amp;self, offset: TextSize) -&gt; Option&lt;usize&gt; {
    self.inner
        .binary_search_by(|directive| {
            if directive.range.end() &lt; offset {
                std::cmp::Ordering::Less
            } else if directive.range.contains(offset) {
                std::cmp::Ordering::Equal
            } else {
                std::cmp::Ordering::Greater
            }
        })
        .ok()
}
</t>
<t tx="ekr.20231231171022.61">pub(crate) fn lines(&amp;self) -&gt; &amp;[NoqaDirectiveLine] {
    &amp;self.inner
}
