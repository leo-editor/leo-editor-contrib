<t tx="ekr.20231231171103.84">/// A trait for transforming ASTs. Visits all nodes in the AST recursively in evaluation-order.
pub trait Transformer {
    @others
}
</t>
<t tx="ekr.20231231171103.85">fn visit_stmt(&amp;self, stmt: &amp;mut Stmt) {
    walk_stmt(self, stmt);
}
</t>
