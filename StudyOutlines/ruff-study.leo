fn message(&amp;self) -&gt; String {
    let TypeNameIncorrectVariance {
        kind,
        param_name,
        variance,
        replacement_name,
    } = self;
    format!("`{kind}` name \"{param_name}\" does not reflect its {variance}; consider renaming it to \"{replacement_name}\"")
}
