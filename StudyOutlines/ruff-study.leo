<t tx="ekr.20231231171115.52">fn range(&amp;self) -&gt; TextRange {
    match self {
        Self::Str(node) =&gt; node.range(),
        Self::Bytes(node) =&gt; node.range(),
        Self::FString(node) =&gt; node.range(),
    }
}
