</t>
<t tx="ekr.20231231171105.21">fn fmt(&amp;self, f: &amp;mut Formatter&lt;PyFormatContext&gt;) -&gt; FormatResult&lt;()&gt; {
    let comments = f.context().comments().clone();

    let dangling_comments = match self {
        Self::Comments(comments) =&gt; comments,
        Self::Node(node) =&gt; comments.dangling(*node),
    };

    let mut first = true;
    for comment in dangling_comments
        .iter()
        .filter(|comment| comment.is_unformatted())
    {
        if first {
            match comment.line_position {
                CommentLinePosition::OwnLine =&gt; {
                    write!(f, [hard_line_break()])?;
                }
                CommentLinePosition::EndOfLine =&gt; {
                    write!(f, [space(), space()])?;
                }
            }
        }

        write!(
            f,
            [
                format_comment(comment),
                empty_lines(lines_after(comment.end(), f.context().source()))
            ]
        )?;

        comment.mark_formatted();

        first = false;
    }

    Ok(())
}
</t>
<t tx="ekr.20231231171105.210">fn push_leading_comment(&amp;mut self, node: AnyNodeRef&lt;'a&gt;, comment: impl Into&lt;SourceComment&gt;) {
