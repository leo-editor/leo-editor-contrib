                            pep8_naming::rules::camelcase_imported_as_lowercase(
                                name,
                                asname,
                                alias,
                                stmt,
                                &amp;checker.settings.pep8_naming.ignore_names,
                            )
                        {
                            checker.diagnostics.push(diagnostic);
                        }
