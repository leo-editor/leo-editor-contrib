<t tx="ekr.20260914081519.7">fn fmt(&amp;self, item: &amp;Operator, f: &amp;mut PyFormatter) -&gt; FormatResult&lt;()&gt; {
    let operator = match item {
        Operator::Add =&gt; "+",
        Operator::Sub =&gt; "-",
        Operator::Mult =&gt; "*",
        Operator::MatMult =&gt; "@",
        Operator::Div =&gt; "/",
        Operator::Mod =&gt; "%",
        Operator::Pow =&gt; "**",
        Operator::LShift =&gt; "&lt;&lt;",
        Operator::RShift =&gt; "&gt;&gt;",
        Operator::BitOr =&gt; "|",
        Operator::BitXor =&gt; "^",
        Operator::BitAnd =&gt; "&amp;",
        Operator::FloorDiv =&gt; "//",
    };

    token(operator).fmt(f)
}
