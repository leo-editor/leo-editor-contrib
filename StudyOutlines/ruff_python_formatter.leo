<t tx="ekr.20260914081518.75">pub(crate) fn new(level: NodeLevel, buffer: &amp;'buf mut B) -&gt; Self {
    let context = buffer.state_mut().context_mut();
    let saved_level = context.node_level();

    context.set_node_level(level);

    Self {
        buffer,
        saved_level,
    }
}
