<t tx="ekr.20260914081518.730">fn assert_valid_char_boundaries(range: TextRange, source: &amp;str) {
    assert!(source.is_char_boundary(usize::from(range.start())));
    assert!(source.is_char_boundary(usize::from(range.end())));
}

