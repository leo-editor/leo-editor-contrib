<t tx="ekr.20260914081518.1106">/// Makes `comment` a [trailing comment](self::trailing-comments) of `node`.
#[inline]
pub(super) fn trailing(node: impl Into&lt;AnyNodeRef&lt;'a&gt;&gt;, comment: DecoratedComment) -&gt; Self {
    Self::Trailing {
        node: node.into(),
