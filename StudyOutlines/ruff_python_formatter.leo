<t tx="ekr.20260914081518.1348">fn fmt_fields(&amp;self, item: &amp;ExprSet, f: &amp;mut PyFormatter) -&gt; FormatResult&lt;()&gt; {
    let ExprSet {
        range: _,
        node_index: _,
        elts,
    } = item;
    // That would be a dict expression
    assert!(!elts.is_empty());
    // Avoid second mutable borrow of f
    let joined = format_with(|f: &amp;mut PyFormatter| {
        f.join_comma_separated(item.end())
            .nodes(elts.iter())
            .finish()
    });

    let comments = f.context().comments().clone();
    let dangling = comments.dangling(item);

    parenthesized("{", &amp;joined, "}")
        .with_dangling_comments(dangling)
        .fmt(f)
}
