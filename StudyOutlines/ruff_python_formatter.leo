<t tx="ekr.20260914081520.64">/// See [`SuiteKind::Other`].
pub fn other(last_suite_in_statement: bool) -&gt; Self {
    Self::Other {
        last_suite_in_statement,
    }
}

</t>
<t tx="ekr.20260914081520.65">pub fn last_suite_in_statement(self) -&gt; bool {
    match self {
        Self::Other {
            last_suite_in_statement,
        } =&gt; last_suite_in_statement,
        _ =&gt; true,
    }
}
