<t tx="ekr.20260914081518.22">pub(crate) fn entries&lt;T, I, F&gt;(&amp;mut self, entries: I) -&gt; &amp;mut Self
where
    T: Ranged,
    F: Format&lt;PyFormatContext&lt;'ast&gt;&gt;,
    I: IntoIterator&lt;Item = (T, F)&gt;,
{
    for (node, content) in entries {
        self.entry(&amp;node, &amp;content);
    }

    self
}

