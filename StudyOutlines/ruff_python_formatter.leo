<t tx="ekr.20260914081518.743">fn narrow_start(&amp;mut self, offset: TextSize) {
    if offset &lt;= self.range.start() {
        self.narrowed_start = self.narrowed_start.max(offset);
    }
}

</t>
<t tx="ekr.20260914081518.744">fn narrow_end(&amp;mut self, offset: TextSize) {
    if offset &gt;= self.range.end() {
        self.narrowed_end = self.narrowed_end.min(offset);
    }
}

