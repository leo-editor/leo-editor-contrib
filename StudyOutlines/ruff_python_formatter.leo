<t tx="ekr.20260914081518.906">type Item = &amp;'a T;
type IntoIter = std::iter::Chain&lt;
    std::iter::Chain&lt;std::slice::Iter&lt;'a, T&gt;, std::slice::Iter&lt;'a, T&gt;&gt;,
    std::slice::Iter&lt;'a, T&gt;,
&gt;;

fn into_iter(self) -&gt; Self::IntoIter {
    self.leading
        .iter()
        .chain(self.dangling)
        .chain(self.trailing)
}
