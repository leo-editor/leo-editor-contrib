<t tx="ekr.20260914081520.2">fn fmt_fields(&amp;self, item: &amp;StmtReturn, f: &amp;mut PyFormatter) -&gt; FormatResult&lt;()&gt; {
    let StmtReturn {
        range: _,
        node_index: _,
        value,
    } = item;

    token("return").fmt(f)?;

    match value.as_deref() {
        Some(Expr::Tuple(tuple)) if !f.context().comments().has_leading(tuple) =&gt; {
            write!(
                f,
                [
                    space(),
                    tuple
                        .format()
                        .with_options(TupleParentheses::OptionalParentheses)
                ]
            )
        }
        Some(value) =&gt; {
            write!(
                f,
                [
                    space(),
                    FormatStatementsLastExpression::left_to_right(value, item)
                ]
            )
        }
        None =&gt; Ok(()),
    }
}

