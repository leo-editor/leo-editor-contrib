<t tx="ekr.20260914081520.250">#[test]
fn normalize_hex_in_byte_string() {
    let input = r"\x89\x50\x4E\x47\x0D\x0A\x1A\x0A";

    let normalized = normalize_string(
        input,
        0,
        AnyStringFlags::new(
            AnyStringPrefix::Bytes(ByteStringPrefix::Regular),
            Quote::Double,
            TripleQuotes::No,
        ),
        false,
    );

    assert_eq!(r"\x89\x50\x4e\x47\x0d\x0a\x1a\x0a", &amp;normalized);
}
