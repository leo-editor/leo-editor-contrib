<t tx="ekr.20260914081518.971">/// Returns true if the node itself or any of its descendants have comments.
pub(crate) fn contains_comments(&amp;self, node: AnyNodeRef) -&gt; bool {
    @others

    if self.has(node) {
        return true;
    }

    let mut visitor = Visitor {
        comments: self,
        has_comment: false,
    };
    node.visit_source_order(&amp;mut visitor);

    visitor.has_comment
}
</t>
