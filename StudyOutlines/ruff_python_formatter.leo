<t tx="ekr.20260914081520.111">/// Returns the indentation of the given line and everything following it.
fn indent_with_suffix(line: &amp;str) -&gt; (&amp;str, &amp;str) {
    let suffix = line.trim_whitespace_start();
    let indent_len = line
        .len()
        .checked_sub(suffix.len())
        .expect("suffix &lt;= line");
    let indent = &amp;line[..indent_len];
    (indent, suffix)
}

</t>
<t tx="ekr.20260914081520.112">/// Returns true if this line looks like a reStructuredText option in a
/// field list.
///
/// That is, a line that looks like `:name: optional-value`.
fn is_rst_option(line: &amp;str) -&gt; bool {
    let line = line.trim_start();
    if !line.starts_with(':') {
        return false;
    }
    line.chars()
        .take_while(|&amp;ch| !is_python_whitespace(ch))
        .any(|ch| ch == ':')
}

