<t tx="ekr.20260914081518.23">pub(crate) fn nodes&lt;'a, T, I&gt;(&amp;mut self, entries: I) -&gt; &amp;mut Self
where
    T: Ranged + AsFormat&lt;PyFormatContext&lt;'ast&gt;&gt; + 'a,
    I: IntoIterator&lt;Item = &amp;'a T&gt;,
{
    for node in entries {
        self.entry(node, &amp;node.format());
    }

    self
}

