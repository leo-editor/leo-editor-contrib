<t tx="ekr.20260914081518.1105">/// Makes `comment` a [dangling comment](self::dangling-comments) of `node`.
pub(super) fn dangling(node: impl Into&lt;AnyNodeRef&lt;'a&gt;&gt;, comment: DecoratedComment) -&gt; Self {
    Self::Dangling {
