<t tx="ekr.20260914081518.726">pub(crate) const fn is_logical_line(node: AnyNodeRef) -&gt; bool {
    // Make sure to update [`FormatEnclosingLine`] when changing this.
    node.is_statement()
        || node.is_decorator()
        || node.is_except_handler()
        || node.is_elif_else_clause()
        || node.is_match_case()
}

#[derive(Debug)]
struct SavedLevel {
    level: usize,
}

