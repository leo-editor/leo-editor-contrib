<t tx="ekr.20260914081518.887">impl OutOfOrderEntry {
    const fn leading_index(&amp;self) -&gt; usize {
        self.leading_index
    }

    const fn dangling_index(&amp;self) -&gt; usize {
        self.leading_index + 1
    }

    const fn trailing_index(&amp;self) -&gt; usize {
        self.leading_index + 2
    }
}

