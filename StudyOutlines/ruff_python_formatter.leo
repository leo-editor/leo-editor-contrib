<t tx="ekr.20260914081518.1479">fn new(context: &amp;'input PyFormatContext) -&gt; Self {
    Self {
        context,
        max_precedence: OperatorPrecedence::None,
        max_precedence_count: 0,
        any_parenthesized_expressions: false,
        last: None,
        first: First::None,
    }
}

