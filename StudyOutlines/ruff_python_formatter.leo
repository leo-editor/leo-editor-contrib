<t tx="ekr.20260914081519.236">fn fmt_fields(&amp;self, item: &amp;PatternMatchClass, f: &amp;mut PyFormatter) -&gt; FormatResult&lt;()&gt; {
    let PatternMatchClass {
        range: _,
        node_index: _,
