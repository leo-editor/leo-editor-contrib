<t tx="ekr.20260914081519.35">/// Inserts any dangling comments that should be placed immediately after the open parenthesis.
/// For example:
/// ```python
/// [  # comment
///     1,
///     2,
///     3,
/// ]
/// ```
pub(crate) fn with_dangling_comments(
    self,
    comments: &amp;'content [SourceComment],
) -&gt; FormatParenthesized&lt;'content, 'ast&gt; {
    FormatParenthesized { comments, ..self }
}

