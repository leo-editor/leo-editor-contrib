<t tx="ekr.20260914081518.1242">#[derive(Debug)]
struct KeyValuePair&lt;'a&gt; {
    key: &amp;'a Option&lt;Expr&gt;,
    value: &amp;'a Expr,
    comments: &amp;'a [SourceComment],
}

</t>
