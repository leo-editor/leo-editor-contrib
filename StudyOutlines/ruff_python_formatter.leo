<t tx="ekr.20260914081518.1150">/// Returns the operator at the given index or `None` if it is out of bounds.
fn get_operator(&amp;self, index: OperatorIndex) -&gt; Option&lt;&amp;Operator&lt;'a&gt;&gt; {
    self.0
        .get(index.value())
        .map(OperandOrOperator::unwrap_operator)
}
