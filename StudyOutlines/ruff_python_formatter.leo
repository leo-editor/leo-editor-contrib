#[derive(Debug)]
enum OperandOrOperator&lt;'a&gt; {
    Operand(Operand&lt;'a&gt;),
    Operator(Operator&lt;'a&gt;),
}

impl&lt;'a&gt; OperandOrOperator&lt;'a&gt; {
    @others
