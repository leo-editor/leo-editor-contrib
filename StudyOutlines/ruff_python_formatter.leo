<t tx="ekr.20260914081518.1104">/// Makes `comment` a [leading comment](self#leading-comments) of `node`.
#[inline]
pub(super) fn leading(node: impl Into&lt;AnyNodeRef&lt;'a&gt;&gt;, comment: DecoratedComment) -&gt; Self {
