use crate::comments::collect_comments;
use crate::{MagicTrailingComma, PreviewMode, PyFormatOptions, format_module_ast};

#[derive(ValueEnum, Clone, Debug)]
pub enum Emit {
    /// Write back to the original files
    Files,
    /// Write to stdout
    Stdout,
}

