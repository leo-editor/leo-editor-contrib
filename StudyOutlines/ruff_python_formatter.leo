<t tx="ekr.20260914081519.337">fn fmt_fields(&amp;self, item: &amp;StmtAssert, f: &amp;mut PyFormatter) -&gt; FormatResult&lt;()&gt; {
    let StmtAssert {
        range: _,
        node_index: _,
        test,
        msg,
    } = item;

    write!(
        f,
        [
            token("assert"),
            space(),
            maybe_parenthesize_expression(test, item, Parenthesize::IfBreaks)
        ]
    )?;

    if let Some(msg) = msg {
        write!(
            f,
            [
                token(","),
                space(),
                maybe_parenthesize_expression(msg, item, Parenthesize::IfBreaksParenthesized),
            ]
        )?;
    }

    Ok(())
}

</t>
