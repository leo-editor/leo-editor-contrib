<t tx="ekr.20260914081518.966">/// Returns an iterator over the [leading](self#leading-comments) and [trailing comments](self#trailing-comments) of `node`.
pub(crate) fn leading_trailing&lt;T&gt;(&amp;self, node: T) -&gt; impl Iterator&lt;Item = &amp;SourceComment&gt;
where
    T: Into&lt;AnyNodeRef&lt;'a&gt;&gt;,
{
    let comments = self.leading_dangling_trailing(node);
    comments.leading.iter().chain(comments.trailing)
}

</t>
<t tx="ekr.20260914081518.967">/// Returns an iterator over the [leading](self#leading-comments), [dangling](self#dangling-comments), and [trailing](self#trailing) comments of `node`.
